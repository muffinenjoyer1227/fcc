local function ensureConfigFolder()
	if not HAS_FILESYSTEM then return end
	if not isfolder("MuffinWare") then
		makefolder("MuffinWare")
	end
	if not isfolder(CONFIG_FOLDER) then
		makefolder(CONFIG_FOLDER)
	end
end

local function serializeSettings()
	local data = {}
	for key, value in pairs(settings) do
		if typeof(value) == "EnumItem" then
			data[key] = tostring(value)
		elseif typeof(value) == "Color3" then
			data[key] = {R = value.R, G = value.G, B = value.B}
		else
			data[key] = value
		end
	end
	return HttpService:JSONEncode(data)
end

local function deserializeSettings(json)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(data) ~= "table" then return end
	if data.BlatantSmoothness and not data.BlatantSmoothX then
		data.BlatantSmoothX = data.BlatantSmoothness
		data.BlatantSmoothY = data.BlatantSmoothness
	end
	if data.BlatantVelocity == false then data.BlatantPredictionMode = "Manual" end

	for key, value in pairs(data) do
		if settings[key] ~= nil then
			if key == SettingsKeys.ACTIVATION_KEY and type(value) == "string" then
				local enumName = value:match("Enum%.KeyCode%.(.+)")
				if enumName and Enum.KeyCode[enumName] then
					value = Enum.KeyCode[enumName]
				end
			elseif key == SettingsKeys.ACTIVATION_MOUSE_BUTTON and type(value) == "string" then
				local enumName = value:match("Enum%.UserInputType%.(.+)")
				if enumName and Enum.UserInputType[enumName] then
					value = Enum.UserInputType[enumName]
				end
			elseif type(value) == "table" and value.R and value.G and value.B then
				value = Color3.new(value.R, value.G, value.B)
			end
			SettingsManager.set(key, value)
		end
	end
end

function SettingsManager.saveConfig(name)
	if not HAS_FILESYSTEM then return false end
	if type(name) ~= "string" or name == "" then return false end
	name = name:gsub("[^%w%-_ ]", ""):gsub("^%s*(.-)%s*$", "%1")
	if name == "" then return false end

	ensureConfigFolder()
	local path = CONFIG_FOLDER .. "/" .. name .. ".json"
	local ok = pcall(writefile, path, serializeSettings())
	return ok
end

function SettingsManager.loadConfig(name)
	if not HAS_FILESYSTEM then return false end
	if type(name) ~= "string" or name == "" then return false end
	local path = CONFIG_FOLDER .. "/" .. name .. ".json"
	if not isfile(path) then return false end

	local ok, content = pcall(readfile, path)
	if not ok or type(content) ~= "string" then return false end

	deserializeSettings(content)
	return true
end

function SettingsManager.deleteConfig(name)
	if not HAS_FILESYSTEM then return false end
	if type(name) ~= "string" or name == "" then return false end

	local path = CONFIG_FOLDER .. "/" .. name .. ".json"
	if not isfile(path) then
		return true
	end

	local ok = pcall(delfile, path)
	if not ok then return false end

	if isfile(path) then
		task.wait(0.05)
	end
	return not isfile(path)
end

function SettingsManager.listConfigs()
	if not HAS_FILESYSTEM then return {} end
	ensureConfigFolder()
	local files = listfiles(CONFIG_FOLDER) or {}
	local names = {}
	for _, file in ipairs(files) do
		local configName = file:match("([^/\\]+)%.json$")
		if configName then
			table.insert(names, configName)
		end
	end
	table.sort(names)
	return names
end

function SettingsManager.setAutoload(name)
	if not HAS_FILESYSTEM then return end
	ensureConfigFolder()
	if name and name ~= "" then
		pcall(writefile, AUTOLOAD_FILE, name)
	else
		if isfile(AUTOLOAD_FILE) then
			pcall(delfile, AUTOLOAD_FILE)
		end
	end
end

function SettingsManager.getAutoload()
	if not HAS_FILESYSTEM then return nil end
	if isfile(AUTOLOAD_FILE) then
		local ok, content = pcall(readfile, AUTOLOAD_FILE)
		if ok and type(content) == "string" and content ~= "" then
			return content
		end
	end
	return nil
end

function SettingsManager.loadAutoload()
	if not HAS_FILESYSTEM then return end
	local name = SettingsManager.getAutoload()
	if name then
		SettingsManager.loadConfig(name)
	end
end

