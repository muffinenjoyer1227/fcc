local function getCharacterPart(data, partName)
	if not data.Character then return nil end
	if partName == "Head" then
		return data.Head
	elseif partName == "HumanoidRootPart" then
		return data.Root
	else
		return data.Character:FindFirstChild(partName)
	end
end

local function computePriorityScore(screenDist, worldDist, partName, assistRadius, maxDistance)
	local screenNorm = math.clamp(screenDist / assistRadius, 0, 1)
	local distNorm = math.clamp(worldDist / maxDistance, 0, 1)
	local score = screenNorm * (1 - CONSTANTS.PRIORITY_DISTANCE_WEIGHT) + distNorm * CONSTANTS.PRIORITY_DISTANCE_WEIGHT
	if partName == "Head" then
		score = score * CONSTANTS.HEAD_PRIORITY_BIAS
	elseif partName == "HumanoidRootPart" then
		score = score * CONSTANTS.TORSO_PRIORITY_BIAS
	end
	return score
end

local function evaluateAimPart(
	player,
	data,
	partName,
	center,
	camera,
	maxDistance,
	assistWallCheck,
	assistRadius
)
	local part = getCharacterPart(data, partName)
	if not part then return nil, math.huge end

	local cameraPos = camera.CFrame.Position
	local worldDist = (part.Position - cameraPos).Magnitude
	if worldDist > maxDistance then return nil, math.huge end

	local visible = true
	if assistWallCheck then
		local character = data.Character
		visible = character ~= nil and isCharacterVisible(character, part, camera)
	end
	if not visible then return nil, math.huge end

	local pos, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen or pos.Z <= 0 then return nil, math.huge end

	local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
	if screenDist > assistRadius then return nil, math.huge end

	return part, computePriorityScore(screenDist, worldDist, partName, assistRadius, maxDistance)
end

local function getClosestTargetToCrosshair(
	camera,
	viewportCenter,
	targetPriorityEnabled,
	maxDistance,
	assistWallCheck,
	assistRadius,
	targetPartName,
	ignoreTeammates
)
	local now = os.clock()
	local last = AimAssistCache.getLastTarget()

	if hotPath.assistSticky and last and last.Parent and last:IsDescendantOf(workspace) then
		local player = Players:GetPlayerFromCharacter(last.Parent)
		if player and isPlayerAlive(player)
			and not (hotPath.assistDownedCheck and isPlayerDowned(player))
			and not (hotPath.assistWhitelistCheck and TargetListManager.isWhitelisted(player.Name))
			and not isTeammate(player, ignoreTeammates) then

			local cameraPos = camera.CFrame.Position
			local worldDist = (last.Position - cameraPos).Magnitude
			if worldDist <= maxDistance then
				local pos, onScreen = camera:WorldToViewportPoint(last.Position)
				if onScreen and pos.Z > 0 then
					local dist = (Vector2.new(pos.X, pos.Y) - viewportCenter).Magnitude
					if dist <= assistRadius then
						local ok = true
						if assistWallCheck then
							local char = last.Parent
							ok = char and isCharacterVisible(char, last, camera)
						end
						if ok then
							AimAssistCache.setLastUpdate(now)
							return last
						end
					end
				end
			end
		end
	end

	local best = nil
	local bestScore = math.huge

	if targetPriorityEnabled then
		PlayerRegistry.forEachEntry(function(player, data)
			if not isPlayerAlive(player) or isTeammate(player, ignoreTeammates) then return end
			if hotPath.assistDownedCheck and isPlayerDowned(player) then return end
			if hotPath.assistWhitelistCheck and TargetListManager.isWhitelisted(player.Name) then
				return
			end

			local playerBestPart = nil
			local playerBestScore = math.huge

			for _, partName in PRIORITY_PARTS do
				local part, score = evaluateAimPart(player, data, partName, viewportCenter, camera, maxDistance, assistWallCheck, assistRadius)
				if part and score < playerBestScore then
					playerBestScore = score
					playerBestPart = part
				end
			end

			if playerBestPart then
				if AimAssistCache.getLastTarget() and playerBestPart == AimAssistCache.getLastTarget() then
					playerBestScore = playerBestScore * CONSTANTS.TARGET_STICKINESS
				end
				if playerBestScore < bestScore then
					bestScore = playerBestScore
					best = playerBestPart
				end
			end
		end)
	else
		PlayerRegistry.forEachEntry(function(player, data)
			if not isPlayerAlive(player) or isTeammate(player, ignoreTeammates) then return end
			if hotPath.assistDownedCheck and isPlayerDowned(player) then return end
			if hotPath.assistWhitelistCheck and TargetListManager.isWhitelisted(player.Name) then
				return
			end

			local part = getTargetPart(data, targetPartName)
			if not part then return end

			local cameraPos = camera.CFrame.Position
			local worldDist = (part.Position - cameraPos).Magnitude
			if worldDist > maxDistance then return end

			local visible = true
			if assistWallCheck then
				local character = data.Character
				visible = character ~= nil and isCharacterVisible(character, part, camera)
			end

			if visible then
				local pos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen and pos.Z > 0 then
					local dist = (Vector2.new(pos.X, pos.Y) - viewportCenter).Magnitude
					if dist < bestScore and dist <= assistRadius then
						bestScore = dist
						best = part
					end
				end
			end
		end)
	end

	AimAssistCache.setLastTarget(best)
	AimAssistCache.setLastUpdate(now)
	return best
end

local function updatePulseFrame()
	globalPulse = CONSTANTS.PULSE_BASE + math.sin(os.clock() * CONSTANTS.PULSE_SPEED) * CONSTANTS.PULSE_AMPLITUDE
end

local function updateAimFrame(dt)
	if not hotPath.assistEnabled then return end

	local camera = getCamera()
	if hotPath.firstPersonOnly and not isFirstPerson(camera) then
		return
	end

	if not isAssistHeld(hotPath.assistMode, hotPath.activationKey, hotPath.activationMouseButton) then
		AimAssistCache.clear()
		return
	end

	local viewportCenter = camera.ViewportSize / 2

	local targetPart = getClosestTargetToCrosshair(
		camera,
		viewportCenter,
		hotPath.targetPriorityEnabled,
		hotPath.maxDistance,
		hotPath.assistWallCheck,
		hotPath.assistRadius,
		hotPath.targetPart,
		hotPath.ignoreTeammates
	)
	if not targetPart then return end

	local targetPlayer = Players:GetPlayerFromCharacter(targetPart.Parent)
	if not targetPlayer then return end

	local delayedPosition = getDelayedTargetPosition(
		targetPlayer,
		targetPart,
		hotPath.jumpTrackDelayEnabled,
		hotPath.jumpDelay
	)

	local currentCFrame = camera.CFrame
	local directionToTarget = (delayedPosition - currentCFrame.Position).Unit

	if currentCFrame.LookVector:Dot(directionToTarget) < math.cos(math.rad(hotPath.maxCorrection)) then
		return
	end

	local screenPos = camera:WorldToViewportPoint(delayedPosition)
	local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude

	if distFromCenter < hotPath.deadzone then return end

	local alpha = 1 - math.exp(-hotPath.assistStrength * hotPath.smoothness * dt * 60)

	local targetCFrame = CFrame.lookAt(
		currentCFrame.Position,
		currentCFrame.Position + directionToTarget
	)

	camera.CFrame = currentCFrame:Lerp(targetCFrame, alpha)
end

