local checksSearchText = ""
local selectedPlayer = nil
local playerRows = {}
local listScroll = nil
local avatarImage = nil

local function getScheme()
	local s = Library and Library.Scheme
	return {
		Font      = (s and s.FontColor) or Color3.fromRGB(240, 240, 240),
		Accent    = (s and s.AccentColor) or Color3.fromRGB(255, 255, 255),
		Outline   = (s and s.OutlineColor) or Color3.fromRGB(60, 60, 60),
		Dark      = Color3.fromRGB(25, 25, 25),
		Row       = Color3.fromRGB(32, 32, 32),
		RowHover  = Color3.fromRGB(42, 42, 42),
		RowSelect = Color3.fromRGB(50, 50, 50),
		Green     = Color3.fromRGB(80, 220, 120),
		Red       = Color3.fromRGB(255, 80, 80),
		White     = Color3.fromRGB(240, 240, 240),
	}
end

local function getPlayerStatus(player)
	if not player then return "Neutral" end
	if TargetListManager.isRageTarget(player.Name) then return "Target" end
	if TargetListManager.isWhitelisted(player.Name) then return "Whitelist" end
	return "Neutral"
end

local function getStatusColor(status)
	local sc = getScheme()
	if status == "Target" then return sc.Red end
	if status == "Whitelist" then return sc.Green end
	return sc.White
end

local function setPlayerStatus(player, status)
	if not player then return end
	TargetListManager.setWhitelisted(player.Name, false)
	TargetListManager.setRageTarget(player.Name, false)
	if status == "Whitelist" then
		TargetListManager.setWhitelisted(player.Name, true)
	elseif status == "Target" then
		TargetListManager.setRageTarget(player.Name, true)
	end
	-- "User" = neither list
	local row = playerRows[player]
	if row then
		local nl = row:FindFirstChild("NameLabel")
		if nl then nl.TextColor3 = getStatusColor(status) end
	end
end

local function updateSelectedUI()
	if not Options.ChecksSelectedInfo then return end

	if not selectedPlayer or not selectedPlayer.Parent then
		Options.ChecksSelectedInfo:SetText("No player selected")
		if Options.ChecksPlayerStatus then
			Options.ChecksPlayerStatus:SetValue("Neutral")
		end
		if avatarImage then
			avatarImage.Image = ""
		end
		return
	end

	Options.ChecksSelectedInfo:SetText(selectedPlayer.DisplayName .. "\n@" .. selectedPlayer.Name)

	if Options.ChecksPlayerStatus then
		Options.ChecksPlayerStatus:SetValue(getPlayerStatus(selectedPlayer))
	end

	if avatarImage then
		local userId = selectedPlayer.UserId
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size150x150
			)
		end)
		if ok and content and content ~= "" then
			avatarImage.Image = content
		else
			avatarImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId="
				.. tostring(userId)
				.. "&width=150&height=150&format=png"
		end
	end
end

local function getContainer(groupbox)
	if groupbox.Container and typeof(groupbox.Container) == "Instance" then
		return groupbox.Container
	end
	local anchor = groupbox:AddLabel("__anchor")
	local obj = anchor.TextLabel or anchor.Label or anchor.Frame
	if typeof(obj) == "Instance" and obj.Parent and obj.Parent:IsA("GuiObject") then
		obj.Visible = false
		return obj.Parent
	end
	return nil
end

