	box:AddSlider(flag, { Text = text, Default = SettingsManager.get(key), Min = minVal, Max = maxVal, Rounding = rounding, Callback = function(Value) SettingsManager.set(key, Value) end })
end

local function bindDropdown(box, flag, text, key, values)
	box:AddDropdown(flag, { Text = text, Values = values, Default = SettingsManager.get(key), Callback = function(Value) SettingsManager.set(key, Value) end })
end

local function bindColor(box, labelText, flag, key)
