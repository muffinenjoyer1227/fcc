local InfStaminaOwner = (function()
	local enabled = false
	local originalFn = nil
	local charConn = nil

	local function apply()
		if not getrenv or not hookfunction or not debug or not debug.getupvalue then
			return false
		end
		local ok = pcall(function()
			local cloned = getrenv()._G.S_Get
			if type(cloned) ~= "function" then
				return
			end
			local target = debug.getupvalue(cloned, 1)
			if type(target) ~= "function" then
				return
			end
			if not originalFn then
				originalFn = hookfunction(target, function(...)
					if enabled then
						return 100, 100
					end
					return originalFn(...)
				end)
			end
		end)
		return ok
	end

	local function enable()
		enabled = true
		apply()
		if charConn then
			charConn:Disconnect()
			charConn = nil
		end
		charConn = LocalPlayer.CharacterAdded:Connect(function()
			if not enabled then return end
			task.wait(1)
			originalFn = nil
			apply()
		end)
	end

	local function disable()
		enabled = false
		if charConn then
			charConn:Disconnect()
			charConn = nil
		end
		if originalFn and getrenv and hookfunction and debug and debug.getupvalue then
			pcall(function()
				local cloned = getrenv()._G.S_Get
				if type(cloned) == "function" then
					local target = debug.getupvalue(cloned, 1)
					if type(target) == "function" then
						hookfunction(target, originalFn)
					end
				end
			end)
		end
		originalFn = nil
	end

	return {
		setEnabled = function(value)
			if value then
				enable()
			else
				disable()
			end
		end,
		reset = function()
			disable()
		end,
	}
end)()

