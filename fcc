local function applyClientACBypass()
	if typeof(getgc) ~= "function" then
		return false, "getgc missing"
	end
	if typeof(hookfunction) ~= "function" then
		return false, "hookfunction missing"
	end
	if typeof(rawget) ~= "function" then
		return false, "rawget missing"
	end

	local ok, err = pcall(function()
		local GC = getgc(true)
		for i = 1, #GC do
			local Index = GC[i]
			if type(Index) == "table" then
				local Detected = rawget(Index, "Detected")
				local CX1 = rawget(Index, "CX1")
				local DTXC1 = rawget(Index, "DTXC1")

				if type(Detected) == "function" then
					pcall(hookfunction, Detected, function(...)
						return true
					end)
				end
				if type(CX1) == "function" then
					pcall(hookfunction, CX1, function(...)
						return true
					end)
				end
				if type(DTXC1) == "function" then
					pcall(hookfunction, DTXC1, function(...)
						return true
					end)
				end

				if rawget(Index, "indexInstance")
					or rawget(Index, "newindexInstance")
					or rawget(Index, "namecallInstance")
					or rawget(Index, "newIndexInstance") then
					pcall(function()
						Index.tvk = {
							"kick",
							function()
								return game:WaitForChild(" ")
							end,
						}
					end)
				end
			end
		end
	end)

	if not ok then
		return false, err
	end
	return true, nil
end

