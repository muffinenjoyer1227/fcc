		if e.hl then pcall(function() e.hl:Destroy() end) end
		disconnectAll(e.conns)
		hcache2[name] = nil
	end

	local function buildBox(plr)
		if not plr or plr == LocalPlayer then return end
		local name = plr.Name
		removeBox(name)

		local char = plr.Character
		if not char or not char:FindFirstChildOfClass("Humanoid") then return end
		if not SettingsManager.get(SettingsKeys.ChamsEnabled) then return end

		local color = SettingsManager.get(SettingsKeys.ChamsColor)
		local alpha = SettingsManager.get(SettingsKeys.ChamsAlpha)
		local glow = SettingsManager.get(SettingsKeys.ChamsGlow) == true
		local glowSize = SettingsManager.get(SettingsKeys.ChamsGlowSize) or 1.14

		local folder = Instance.new("Folder")
		folder.Name = name .. "_CHAMS"
		folder.Parent = coreParent()

		local entry = { folder = folder, conns = {} }
		cache[name] = entry

		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local aIn = Instance.new("BoxHandleAdornment")
				aIn.Name = "in"
				aIn.Adornee = part
				aIn.AlwaysOnTop = true
				aIn.ZIndex = 1
				aIn.Size = part.Size + Vector3.new(-0.1, -0.1, -0.1)
				aIn.Color3 = color
				aIn.Transparency = alpha
				aIn.Parent = folder

				local aOut = Instance.new("BoxHandleAdornment")
				aOut.Name = "out"
				aOut.Adornee = part
				aOut.AlwaysOnTop = glow
				aOut.ZIndex = -1
				aOut.Size = part.Size + Vector3.new(0.1, 0.1, 0.1)
				aOut.Color3 = color
				aOut.Transparency = glow and (alpha / glowSize) or alpha
				aOut.Parent = folder
			end
		end
	end

	local function buildOccludedHL(plr)
		if not plr or plr == LocalPlayer then return end
		local name = plr.Name
		removeHL(name)

		local char = plr.Character
		if not char then return end
		if not SettingsManager.get(SettingsKeys.HChamsOccludedEnabled) then return end

		local hl = Instance.new("Highlight")
		hl.Name = "HChams2_" .. name
		hl.Adornee = char
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.FillColor = SettingsManager.get(SettingsKeys.HChamsOccludedFillColor)
		hl.OutlineColor = SettingsManager.get(SettingsKeys.HChamsOccludedOutlineColor)
		hl.FillTransparency = SettingsManager.get(SettingsKeys.HChamsOccludedFillAlpha)
		hl.OutlineTransparency = SettingsManager.get(SettingsKeys.HChamsOccludedOutlineAlpha)
		hl.Parent = coreParent()
		hcache2[name] = { hl = hl, conns = {} }
	end

	local function rebuildPlayer(plr)
		if not plr or plr == LocalPlayer then return end
		if not shouldShowESPForPlayer(plr) then
			removeBox(plr.Name)
			removeHL(plr.Name)
			return
		end
		task.defer(function()
			if SettingsManager.get(SettingsKeys.ChamsEnabled) then
				buildBox(plr)
			else
				removeBox(plr.Name)
			end
			if SettingsManager.get(SettingsKeys.HChamsOccludedEnabled) then
				buildOccludedHL(plr)
			else
				removeHL(plr.Name)
			end
		end)
	end

	local function disconnectCharConns(plr)
		local list = playerCharConns[plr]
		if not list then return end
		disconnectAll(list)
		playerCharConns[plr] = nil
	end

	local function removePlayer(plr)
		if not plr then return end
		disconnectCharConns(plr)
		local name = plr.Name
		removeBox(name)
		removeHL(name)
	end

	local function hookCharacter(plr, char)
		disconnectCharConns(plr)
		local charConns = {}
		playerCharConns[plr] = charConns

		local function scheduleRebuild()
			task.defer(function()
				if not running or plr.Parent == nil then return end
				task.wait(0.2)
				if not running or plr.Parent == nil then return end
				rebuildPlayer(plr)
			end)
		end

		task.defer(function()
			if not running or plr.Parent == nil then return end
			if char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5) then
				scheduleRebuild()
			end
		end)

		table.insert(charConns, char.ChildAdded:Connect(function(child)
			if child:IsA("BasePart") then
				scheduleRebuild()
			end
		end))
	end

	local function hookPlayer(plr)
		if plr == LocalPlayer then return end
		if plr.Character then
			hookCharacter(plr, plr.Character)
		else
			rebuildPlayer(plr)
		end
		table.insert(conns, plr.CharacterAdded:Connect(function(char)
			hookCharacter(plr, char)
		end))
	end

	local function needsRepair(plr)
		local name = plr.Name
		local anyEnabled = SettingsManager.get(SettingsKeys.ChamsEnabled)
			or SettingsManager.get(SettingsKeys.HChamsOccludedEnabled)
		if not anyEnabled or not plr.Character then return false end

		if SettingsManager.get(SettingsKeys.ChamsEnabled) then
			local e = cache[name]
			if not e or not e.folder or not e.folder.Parent or #e.folder:GetChildren() == 0 then
				return true
			end
		end

		if SettingsManager.get(SettingsKeys.HChamsOccludedEnabled) then
			local e = hcache2[name]
			if not e or not e.hl or not e.hl.Parent then
				return true
			end
		end

		return false
	end

	local function start()
		if running then return end
		running = true
		for _, plr in ipairs(Players:GetPlayers()) do
			hookPlayer(plr)
		end
		table.insert(conns, Players.PlayerAdded:Connect(hookPlayer))
		table.insert(conns, Players.PlayerRemoving:Connect(removePlayer))
		task.spawn(function()
			while running do
				task.wait(2.5)
				if not running then break end
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= LocalPlayer and needsRepair(plr) then
						rebuildPlayer(plr)
					end
				end
			end
		end)
	end

	local function stop()
		if not running then return end
		running = false
		disconnectAll(conns)
		table.clear(conns)
		for plr in pairs(playerCharConns) do
			disconnectCharConns(plr)
		end
		for name in pairs(cache) do removeBox(name) end
		for name in pairs(hcache2) do removeHL(name) end
	end

	return {
		rebuildPlayer = rebuildPlayer,
		removePlayer = removePlayer,
		start = start,
		stop = stop,
		reset = function()
			stop()
		end,
	}
end)()

getCamera = function()
	return workspace.CurrentCamera
end

local function isFirstPerson(camera)
	return (camera.Focus.Position - camera.CFrame.Position).Magnitude <= CONSTANTS.FIRST_PERSON_FOCUS_THRESHOLD
end

isPlayerAlive = function(player)
	local data = PlayerRegistry.ensureFresh(player)
	if not data then
		return false
	end
	local humanoid = data.Humanoid
	return humanoid ~= nil and humanoid.Health > 0
end

local function isPlayerDowned(player)
	local character = player.Character
	if not character then return true end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return true end

	local charStats = ReplicatedStorage:FindFirstChild("CharStats")
	if charStats then
		local stats = charStats:FindFirstChild(player.Name)
		if stats then
			local downed = stats:FindFirstChild("Downed")
			if downed and downed:IsA("BoolValue") and downed.Value then
				return true
			end
		end
	end

	if humanoid.Health <= 15 then
		return true
	end

	return false
end


local blatantPressed = false
local blatantAimPlayer = nil
local blatantCurrentDist = math.huge

local function getClosestBlatantPlayer(camera, mousePos, fov)
	local closest = nil
	local closestDist = fov

	local teamCheck = SettingsManager.get(SettingsKeys.BlatantTeamCheck)
	local whitelistCheck = SettingsManager.get(SettingsKeys.BlatantWhitelistCheck)
	local wallCheck = SettingsManager.get(SettingsKeys.BlatantWallCheck)

	PlayerRegistry.forEachEntry(function(player, data)
		if not isPlayerAlive(player) then return end
		if teamCheck and player.Team == LocalPlayer.Team and player.Team ~= nil then return end
		if whitelistCheck and TargetListManager.isWhitelisted(player.Name) then return end
		if SettingsManager.get(SettingsKeys.BlatantDownedCheck) and isPlayerDowned(player) then return end

		local character = data.Character
		local hrp = data.Root
		if not character or not hrp then return end

		local partName = SettingsManager.get(SettingsKeys.BlatantTargetPart)
		local aimPart = character:FindFirstChild(partName)
			or character:FindFirstChild("Head")
			or hrp
		if not aimPart or not aimPart:IsA("BasePart") then return end

		if wallCheck and not VisibilityCache.isCharacterVisible(character, aimPart, camera) then
			return
		end

		local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
		if not onScreen then return end

		local distScreen = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
		if distScreen < closestDist then
			closest = player
			closestDist = distScreen
		end
	end)

	return closest, closestDist
end

local function isBlatantInputMatch(input)
	local mode = SettingsManager.get(SettingsKeys.ASSIST_MODE)
	if mode == "X Key" then
		return input.UserInputType == Enum.UserInputType.Keyboard
			and input.KeyCode == SettingsManager.get(SettingsKeys.ACTIVATION_KEY)
	elseif mode == "Right Mouse Button" then
		return input.UserInputType == SettingsManager.get(SettingsKeys.ACTIVATION_MOUSE_BUTTON)
	end
	return false
end

local function lockBlatantTarget()
	local camera = getCamera()
	local mousePos = UserInputService:GetMouseLocation()
	local fov = SettingsManager.get(SettingsKeys.BlatantFOV)
	local target, dist = getClosestBlatantPlayer(camera, mousePos, fov)
	if target then
		blatantAimPlayer = target
		blatantCurrentDist = dist
	else
		blatantAimPlayer = nil
		blatantCurrentDist = math.huge
	end
end

local function updateBlatantAimFrame(_dt)
	if not SettingsManager.get(SettingsKeys.AssistEnabled) then
		BlatantOwner.clearTarget()
		BlatantOwner.hideFOV()
		blatantAimPlayer = nil
		blatantCurrentDist = math.huge
		return
	end

	local camera = getCamera()
	local mousePos = UserInputService:GetMouseLocation()
	BlatantOwner.updateFOV()

	local canUsing = isFirstPerson(camera)
	local fov = SettingsManager.get(SettingsKeys.BlatantFOV)
	local wallCheck = SettingsManager.get(SettingsKeys.BlatantWallCheck)

	if not blatantPressed then
		blatantAimPlayer = nil
		blatantCurrentDist = math.huge
		BlatantOwner.clearTarget()
		return
	end

	local valid = false
	if blatantAimPlayer and blatantAimPlayer.Character then
		local hum = blatantAimPlayer.Character:FindFirstChildOfClass("Humanoid")
		valid = hum ~= nil and hum.Health > 0
		if valid and SettingsManager.get(SettingsKeys.BlatantDownedCheck) then
			valid = not isPlayerDowned(blatantAimPlayer)
		end
		if valid and wallCheck then
			local partName = SettingsManager.get(SettingsKeys.BlatantTargetPart)
			local aimPart = blatantAimPlayer.Character:FindFirstChild(partName)
				or blatantAimPlayer.Character:FindFirstChild("Head")
				or blatantAimPlayer.Character:FindFirstChild("HumanoidRootPart")
			valid = aimPart ~= nil
				and aimPart:IsA("BasePart")
				and VisibilityCache.isCharacterVisible(blatantAimPlayer.Character, aimPart, camera)
		end
	end

	if not valid then
		blatantAimPlayer = nil
		blatantCurrentDist = math.huge
		local newTarget, newDist = getClosestBlatantPlayer(camera, mousePos, fov)
		if newTarget then
			blatantAimPlayer = newTarget
			blatantCurrentDist = newDist
		end
	else
		if not SettingsManager.get(SettingsKeys.BlatantSticky) then
			local newTarget, newDist = getClosestBlatantPlayer(camera, mousePos, fov)
			if newTarget and newTarget ~= blatantAimPlayer and newDist < blatantCurrentDist then
				blatantAimPlayer = newTarget
				blatantCurrentDist = newDist
			end
		end
	end

	if blatantAimPlayer and blatantAimPlayer.Character then
		local hrp = blatantAimPlayer.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local _, onScreen = camera:WorldToViewportPoint(hrp.Position)
			if not onScreen then
				blatantAimPlayer = nil
				blatantCurrentDist = math.huge
			end
		else
			blatantAimPlayer = nil
			blatantCurrentDist = math.huge
		end
	end

	if not (blatantPressed and blatantAimPlayer and blatantAimPlayer.Character and canUsing) then
		BlatantOwner.clearTarget()
		return
	end

	local humanoid = blatantAimPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		BlatantOwner.clearTarget()
		return
	end

	local partName = SettingsManager.get(SettingsKeys.BlatantTargetPart)
	local targetPart = blatantAimPlayer.Character:FindFirstChild(partName)
		or blatantAimPlayer.Character:FindFirstChild("Head")
	if not targetPart or not targetPart:IsA("BasePart") then
		BlatantOwner.clearTarget()
		return
	end

	BlatantOwner.setTarget(targetPart)

	local targetPosition = targetPart.Position
	local vel = targetPart.AssemblyLinearVelocity
	local predMode = SettingsManager.get(SettingsKeys.BlatantPredictionMode)
	if predMode == "Manual" then
		local predict = SettingsManager.get(SettingsKeys.BlatantPrediction) or 15
		if predict > 0 then
			targetPosition = targetPosition + vel / predict
		end
	elseif predMode == "Auto" then
		local autoPred = math.clamp((targetPosition - camera.CFrame.Position).Magnitude / 12, 8, 28)
		targetPosition = targetPosition + vel / autoPred
	end
	local sx = SettingsManager.get(SettingsKeys.BlatantSmoothX) or 0.35
	local sy = SettingsManager.get(SettingsKeys.BlatantSmoothY) or 0.35
	local ease = SettingsManager.get(SettingsKeys.BlatantEasing) or "linear"
	local function eze(t)
		t = math.clamp(t, 0, 1)
		if ease == "easein" then return t * t
		elseif ease == "easeout" then return t * (2 - t)
		elseif ease == "smoothstep" then return t * t * (3 - 2 * t) end
		return t
	end
	local ax, ay = eze(sx), eze(sy)
	if ax >= 0.99 and ay >= 0.99 then
		camera.CFrame = CFrame.new(camera.CFrame.Position, targetPosition)
	else
		local cur = camera.CFrame
		local goal = CFrame.new(cur.Position, targetPosition)
		local cx, cy = cur:ToOrientation()
		local tx, ty = goal:ToOrientation()
		local function ad(a, b)
			local d = b - a
			while d > math.pi do d -= math.pi * 2 end
			while d < -math.pi do d += math.pi * 2 end
			return d
		end
		camera.CFrame = CFrame.new(cur.Position) * CFrame.fromOrientation(cx + ad(cx, tx) * ay, cy + ad(cy, ty) * ax, 0)
	end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
	if gp or UserInputService:GetFocusedTextBox() then return end
	if hotPath.cameraMode ~= "blatant" then return end
	if not SettingsManager.get(SettingsKeys.AssistEnabled) then return end
	if not isBlatantInputMatch(input) then return end

	blatantPressed = true
	lockBlatantTarget()
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if not isBlatantInputMatch(input) then return end
	blatantPressed = false
	blatantAimPlayer = nil
	blatantCurrentDist = math.huge
end))

local function hideChams(data)
	if data.Highlight then data.Highlight.Enabled = false end
	data.LastFillColor = nil
	data.LastFillTransparency = nil
	data.LastOutlineTransparency = nil
end

local function hideESP(data)
	hideChams(data)
end

local function cleanupLegacyHealthBar(data)
	if data.HealthConn then
		pcall(function() data.HealthConn:Disconnect() end)
		data.HealthConn = nil
	end
	if data.HealthBar then
		pcall(function() data.HealthBar:Destroy() end)
		data.HealthBar = nil
		data.HealthFill = nil
	end
end

destroyESP = function(data)
	cleanupLegacyHealthBar(data)
	if data.Highlight then
		data.Highlight:Destroy()
		data.Highlight = nil
	end
end

do
	local cache = {}
	local jumpTrack = {}
	local playerLifecycleConnections = {}
	local humanoidDiedTracked = {}
	local repairLogTimes = {}

	local debugRegistry = getgenv().FraudCCDebugRegistry == true
	local onCharacterRelease = nil
	local onTransientReset = nil

	local function isPlayerInGame(player)
		return player ~= nil and player.Parent == Players
	end

	local function isPartOfCharacter(instance, character)
		return instance ~= nil
			and character ~= nil
			and instance.Parent ~= nil
			and instance:IsDescendantOf(character)
	end

	local function logRepair(player, reason)
		if not debugRegistry then return end
		local now = os.clock()
		local playerLog = repairLogTimes[player]
		if not playerLog then
			playerLog = {}
			repairLogTimes[player] = playerLog
		end
		local last = playerLog[reason]
		if last and (now - last) < CONSTANTS.REGISTRY_REPAIR_LOG_INTERVAL then
			return
		end
		playerLog[reason] = now
		print(string.format("[PlayerRegistry] REPAIRED %s reason = %s", player.Name, reason))
	end

	local function invalidateOrphanedAdornments(data)
		if data.NameTag and not data.NameTag.Parent then
			data.NameTag = nil
			data.NameText = nil
			data.LastNameColor = nil
		end
		if data.ToolTag and not data.ToolTag.Parent then
			data.ToolTag = nil
			data.ToolText = nil
		end
		if data.HealthBar and not data.HealthBar.Parent then
			if data.HealthConn then
				pcall(function() data.HealthConn:Disconnect() end)
				data.HealthConn = nil
			end
			data.HealthBar = nil
			data.HealthFill = nil
		end
		if data.Highlight and (not data.Highlight.Parent or not data.Highlight.Adornee) then
			data.Highlight = nil
		end
	end

	local function disconnectCharacterConnections(data)
		for _, conn in data.characterConnections do
			pcall(function() conn:Disconnect() end)
		end
		table.clear(data.characterConnections)
	end

	local function disconnectPlayerLifecycle(player)
		local conns = playerLifecycleConnections[player]
		if not conns then return end
		for _, conn in conns do
			pcall(function() conn:Disconnect() end)
		end
		playerLifecycleConnections[player] = nil
	end

	local function createEmptyEntry(character)
		return {
			Character = character,
			Humanoid = nil,
			Root = nil,
			Head = nil,
			Highlight = nil,
			NameTag = nil,
			NameText = nil,
			ToolTag = nil,
			ToolText = nil,
			HealthBar = nil,
			HealthFill = nil,
			HealthConn = nil,
			LastDistance = 0,
			LastNameText = nil,
			LastNameColor = nil,
			LastFillColor = nil,
			LastFillTransparency = nil,
			LastOutlineTransparency = nil,
			characterConnections = {},
		}
	end

	local function ensureHumanoidDiedHook(player, data)
		local humanoid = data.Humanoid
		if not humanoid then
			humanoidDiedTracked[player] = nil
			return
		end
		if humanoidDiedTracked[player] == humanoid then
			return
		end
		humanoidDiedTracked[player] = humanoid
		table.insert(data.characterConnections, humanoid.Died:Connect(function()
			hideESP(data)
		end))
	end

	local function resolveCharacterParts(player, character, data)
		local reasons = {}

		if not isPartOfCharacter(data.Humanoid, character) then
			if data.Humanoid then
				table.insert(reasons, "StaleHumanoid")
			else
				table.insert(reasons, "HumanoidMissing")
			end
			data.Humanoid = character:FindFirstChildOfClass("Humanoid")
		end

		if not isPartOfCharacter(data.Root, character) then
			if data.Root then
				table.insert(reasons, "StaleRoot")
			else
				table.insert(reasons, "RootMissing")
			end
			data.Root = character:FindFirstChild("HumanoidRootPart")
				or character:FindFirstChild("Torso")
		end

		if not isPartOfCharacter(data.Head, character) then
			if data.Head then
				table.insert(reasons, "StaleHead")
			else
				table.insert(reasons, "HeadMissing")
			end
			data.Head = character:FindFirstChild("Head")
		end

		invalidateOrphanedAdornments(data)
		ensureHumanoidDiedHook(player, data)
		return reasons
	end

	local function clearCharacterFields(data, keepEntry)
		data.Character = nil
		data.Humanoid = nil
		data.Root = nil
		data.Head = nil
		if not keepEntry then
			return
		end
		invalidateOrphanedAdornments(data)
	end

	local function onCharacterRemoving(player, data, character)
		disconnectCharacterConnections(data)
		VisibilityCache.clearForCharacter(character)
		clearCharacterFields(data, true)
		humanoidDiedTracked[player] = nil
	end

	local function attachCharacterSignals(player, character, data)
		disconnectCharacterConnections(data)

		local function onRelevantChildChanged(child)
			if child.Name == "Head" or child.Name == "HumanoidRootPart" or child:IsA("Humanoid") then
				local reasons = resolveCharacterParts(player, character, data)
				for _, reason in reasons do
					logRepair(player, reason)
				end
			end
		end

		table.insert(data.characterConnections, character.ChildAdded:Connect(onRelevantChildChanged))
		table.insert(data.characterConnections, character.ChildRemoved:Connect(function(child)
			if child == data.Head then
				data.Head = nil
				logRepair(player, "HeadMissing")
			elseif child == data.Root then
				data.Root = nil
				logRepair(player, "RootMissing")
			elseif child == data.Humanoid then
				data.Humanoid = nil
				humanoidDiedTracked[player] = nil
				logRepair(player, "HumanoidMissing")
			end
			onRelevantChildChanged(child)
		end))
		table.insert(data.characterConnections, character.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				onCharacterRemoving(player, data, character)
			end
		end))
		table.insert(data.characterConnections, character.Destroying:Connect(function()
			onCharacterRemoving(player, data, character)
		end))
	end

	local function releaseCharacter(player, data, reason)
		if data.Character then
			VisibilityCache.clearForCharacter(data.Character)
		end
		if onCharacterRelease then
			onCharacterRelease(player, data)
		end
		disconnectCharacterConnections(data)
		humanoidDiedTracked[player] = nil
		logRepair(player, reason)
	end

	local function assignCharacter(player, character, reason)
		local old = cache[player]
		if old and old.Character == character then
			old.Character = character
			local reasons = resolveCharacterParts(player, character, old)
			for _, repairReason in reasons do
				logRepair(player, repairReason)
			end
			return old
		end

		if onTransientReset then
			onTransientReset(player)
		end

		if old then
			releaseCharacter(player, old, reason)
		end

		local data = createEmptyEntry(character)
		cache[player] = data
		attachCharacterSignals(player, character, data)

		local reasons = resolveCharacterParts(player, character, data)
		for _, repairReason in reasons do
			logRepair(player, repairReason)
		end

		return data
	end

	local function ensureFresh(player)
		if not isPlayerInGame(player) then
			return nil
		end

		local data = cache[player]
		local character = player.Character

		if not data then
			if character then
				return assignCharacter(player, character, "NotRegistered")
			end
			return nil
		end

		if not character then
			if data.Character then
				disconnectCharacterConnections(data)
				VisibilityCache.clearForCharacter(data.Character)
				clearCharacterFields(data, true)
				humanoidDiedTracked[player] = nil
			end
			return data
		end

		if data.Character ~= character then
			return assignCharacter(player, character, "CharacterChanged")
		end

		local reasons = resolveCharacterParts(player, character, data)
		if #reasons > 0 then
			for _, reason in reasons do
				logRepair(player, reason)
			end
		end

		return data
	end

	function PlayerRegistry.disconnectCharacterConnections(data)
		disconnectCharacterConnections(data)
	end

	function PlayerRegistry.setOnCharacterRelease(callback)
		onCharacterRelease = callback
	end

	function PlayerRegistry.setOnTransientReset(callback)
		onTransientReset = callback
	end

	function PlayerRegistry.setDebug(enabled)
		debugRegistry = enabled == true
		getgenv().FraudCCDebugRegistry = debugRegistry
	end

	function PlayerRegistry.getDiagnostics(player)
		local data = cache[player]
		local character = player.Character
		return {
			registered = data ~= nil,
			inGame = isPlayerInGame(player),
			characterValid = character ~= nil and character.Parent ~= nil,
			cacheCharacterMatches = data ~= nil and data.Character == character,
			humanoidValid = data ~= nil and isPartOfCharacter(data.Humanoid, data.Character),
			rootValid = data ~= nil and isPartOfCharacter(data.Root, data.Character),
			headValid = data ~= nil and isPartOfCharacter(data.Head, data.Character),
		}
	end

	function PlayerRegistry.ensureFresh(player)
		return ensureFresh(player)
	end

	function PlayerRegistry.get(player)
		return ensureFresh(player)
	end

	function PlayerRegistry.forEachEntry(callback)
		for player in pairs(cache) do
			local data = ensureFresh(player)
			if data then
				callback(player, data)
			end
		end
	end

	function PlayerRegistry.registerPlayer(player)
		if player == LocalPlayer then return end

		if not playerLifecycleConnections[player] then
			playerLifecycleConnections[player] = {}
		end

		if player.Character then
			assignCharacter(player, player.Character, "InitialCharacter")
		else
			cache[player] = cache[player] or createEmptyEntry(nil)
		end

		local lifecycle = playerLifecycleConnections[player]
		if #lifecycle == 0 then
			table.insert(lifecycle, player.CharacterAdded:Connect(function(character)
				assignCharacter(player, character, "CharacterAdded")
			end))
		end
	end

	function PlayerRegistry.reconcileAll()
		for player in pairs(cache) do
			ensureFresh(player)
		end
	end

	function PlayerRegistry.getJumpTrack(player)
		return jumpTrack[player]
	end

	function PlayerRegistry.setJumpTrack(player, entry)
		jumpTrack[player] = entry
	end

	function PlayerRegistry.clearJumpTrack(player)
		jumpTrack[player] = nil
	end

	function PlayerRegistry.clearVisibilityFor(player)
		local data = cache[player]
		if data and data.Character then
			VisibilityCache.clearForCharacter(data.Character)
		end
	end

	function PlayerRegistry.clear(player)
		local data = cache[player]
		if data then
			disconnectCharacterConnections(data)
			if data.Character then
				VisibilityCache.clearForCharacter(data.Character)
			end
		end
		disconnectPlayerLifecycle(player)
		cache[player] = nil
		jumpTrack[player] = nil
		humanoidDiedTracked[player] = nil
		repairLogTimes[player] = nil
	end

	function PlayerRegistry.clearAll()
		for player in pairs(cache) do
			PlayerRegistry.clear(player)
		end
		table.clear(cache)
		table.clear(jumpTrack)
		table.clear(playerLifecycleConnections)
		table.clear(humanoidDiedTracked)
		table.clear(repairLogTimes)
	end
end

local SKELETON_SEGMENT_COUNT = 11
local SkeletonLines = {}

local OUTLINE_COLOR = Color3.new(0, 0, 0)
local OUTLINE_THICKNESS = 2
local FILL_THICKNESS = 1

local function clearSkeletonForPlayer(player)
	local lines = SkeletonLines[player]
	if not lines then return end
	for _, pair in ipairs(lines) do
		pcall(function()
			if pair.Outline then pair.Outline:Remove() end
			if pair.Fill then pair.Fill:Remove() end
		end)
	end
	SkeletonLines[player] = nil
end

local function clearAllSkeletons()
	for player in pairs(SkeletonLines) do
		clearSkeletonForPlayer(player)
	end
end

local function makeLine(color, thickness)
	local line = Drawing.new("Line")
	line.Color = color
	line.Thickness = thickness
	line.Transparency = 1
	line.Visible = false
	return line
end

local function ensureSkeletonLines(player, color)
	if SkeletonLines[player] then
		return SkeletonLines[player]
	end
	local lines = {}
	for i = 1, SKELETON_SEGMENT_COUNT do
		lines[i] = {
			Outline = makeLine(OUTLINE_COLOR, OUTLINE_THICKNESS),
			Fill = makeLine(color, FILL_THICKNESS),
		}
	end
	SkeletonLines[player] = lines
	return lines
end

local function getBoxySkeleton(char)
	local segments = {}
	local function add(a, b)
		if a and b then
			table.insert(segments, { a, b })
		end
	end

	local function joint(part, yScale)
		if not part then return nil end
		return (part.CFrame * CFrame.new(0, part.Size.Y * yScale, 0)).Position
	end

	if char:FindFirstChild("UpperTorso") then
		local head = char:FindFirstChild("Head")
		local upperTorso = char:FindFirstChild("UpperTorso")
		local lowerTorso = char:FindFirstChild("LowerTorso")
		local leftUpperArm = char:FindFirstChild("LeftUpperArm")
		local rightUpperArm = char:FindFirstChild("RightUpperArm")
		local leftHand = char:FindFirstChild("LeftHand")
		local rightHand = char:FindFirstChild("RightHand")
		local leftUpperLeg = char:FindFirstChild("LeftUpperLeg")
		local rightUpperLeg = char:FindFirstChild("RightUpperLeg")
		local leftFoot = char:FindFirstChild("LeftFoot")
		local rightFoot = char:FindFirstChild("RightFoot")
		local leftLowerArm = char:FindFirstChild("LeftLowerArm")
		local rightLowerArm = char:FindFirstChild("RightLowerArm")
		local leftLowerLeg = char:FindFirstChild("LeftLowerLeg")
		local rightLowerLeg = char:FindFirstChild("RightLowerLeg")

		local neck = joint(upperTorso, 0.5)
		local pelvis = joint(lowerTorso, -0.5)
		local leftShoulder = joint(leftUpperArm, 0.5)
		local rightShoulder = joint(rightUpperArm, 0.5)
		local leftHip = joint(leftUpperLeg, 0.5)
		local rightHip = joint(rightUpperLeg, 0.5)

		local leftArmEnd = leftHand or leftLowerArm or leftUpperArm
		local rightArmEnd = rightHand or rightLowerArm or rightUpperArm
		local leftLegEnd = leftFoot or leftLowerLeg or leftUpperLeg
		local rightLegEnd = rightFoot or rightLowerLeg or rightUpperLeg

		add(head and head.Position or nil, neck)
		add(neck, pelvis)
		add(neck, leftShoulder)
		add(neck, rightShoulder)
		add(leftShoulder, leftArmEnd and leftArmEnd.Position or nil)
		add(rightShoulder, rightArmEnd and rightArmEnd.Position or nil)
		add(pelvis, leftHip)
		add(pelvis, rightHip)
		add(leftHip, leftLegEnd and leftLegEnd.Position or nil)
		add(rightHip, rightLegEnd and rightLegEnd.Position or nil)
	else
		-- R6
		local head = char:FindFirstChild("Head")
		local torso = char:FindFirstChild("Torso")
		local leftArm = char:FindFirstChild("Left Arm")
		local rightArm = char:FindFirstChild("Right Arm")
		local leftLeg = char:FindFirstChild("Left Leg")
		local rightLeg = char:FindFirstChild("Right Leg")

		local function tip(part, yScale)
			if not part then return nil end
			return (part.CFrame * CFrame.new(0, part.Size.Y * yScale, 0)).Position
		end

		local neck = torso and tip(torso, 0.5) or nil
		local pelvis = torso and tip(torso, -0.5) or nil
		local leftShoulder = torso and (torso.CFrame * CFrame.new(-torso.Size.X * 0.5, torso.Size.Y * 0.5, 0)).Position or nil
		local rightShoulder = torso and (torso.CFrame * CFrame.new(torso.Size.X * 0.5, torso.Size.Y * 0.5, 0)).Position or nil
		local leftHip = torso and (torso.CFrame * CFrame.new(-torso.Size.X * 0.25, -torso.Size.Y * 0.5, 0)).Position or nil
		local rightHip = torso and (torso.CFrame * CFrame.new(torso.Size.X * 0.25, -torso.Size.Y * 0.5, 0)).Position or nil

		-- distal ends (hands / feet), not part centers
		local leftHand = tip(leftArm, -0.5)
		local rightHand = tip(rightArm, -0.5)
		local leftFoot = tip(leftLeg, -0.5)
		local rightFoot = tip(rightLeg, -0.5)

		add(head and head.Position or nil, neck)
		add(neck, pelvis)
		add(neck, leftShoulder)
		add(neck, rightShoulder)
		add(leftShoulder, leftHand)
		add(rightShoulder, rightHand)
		add(pelvis, leftHip)
		add(pelvis, rightHip)
		add(leftHip, leftFoot)
		add(rightHip, rightFoot)
	end

	return segments
end

local function projectSeg(camera, a, b)
	local p1, on1 = camera:WorldToViewportPoint(a)
	local p2, on2 = camera:WorldToViewportPoint(b)
	if on1 and on2 and p1.Z > 0 and p2.Z > 0 then
		return Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y), true
	end
	return nil, nil, false
end

local function updateSkeletonESP()
	if unloaded then return end

	local camera = workspace.CurrentCamera
	if not camera
		or not SettingsManager.get(SettingsKeys.ESPEnabled)
		or not SettingsManager.get(SettingsKeys.SkeletonESP) then
		for _, lines in pairs(SkeletonLines) do
			for _, pair in ipairs(lines) do
				pair.Outline.Visible = false
				pair.Fill.Visible = false
			end
		end
		return
	end

	local color = SettingsManager.get(SettingsKeys.SkeletonColor)
	local maxDist = SettingsManager.get(SettingsKeys.ESP_DISTANCE) or 1000
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local myPos = myRoot and myRoot.Position or camera.CFrame.Position
	local outlineOn = true

	for _, player in ipairs(Players:GetPlayers()) do
		repeat
			if player == LocalPlayer then
				break
			end

			if not shouldShowESPForPlayer(player) then
				if SkeletonLines[player] then
					for _, pair in ipairs(SkeletonLines[player]) do
						pair.Outline.Visible = false
						pair.Fill.Visible = false
					end
				end
				break
			end

			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if not character or not humanoid or not root or humanoid.Health <= 0 then
				if SkeletonLines[player] then
					for _, pair in ipairs(SkeletonLines[player]) do
						pair.Outline.Visible = false
						pair.Fill.Visible = false
					end
				end
				break
			end

			if (root.Position - myPos).Magnitude > maxDist then
				if SkeletonLines[player] then
					for _, pair in ipairs(SkeletonLines[player]) do
						pair.Outline.Visible = false
						pair.Fill.Visible = false
					end
				end
				break
			end

			local segments = getBoxySkeleton(character)
			local lines = ensureSkeletonLines(player, color)

			for i = 1, SKELETON_SEGMENT_COUNT do
				local pair = lines[i]
				local seg = segments[i]
				if pair and seg then
					local from, to, ok = projectSeg(camera, seg[1], seg[2])
					if ok and from and to then
						pair.Outline.From = from
						pair.Outline.To = to
						pair.Outline.Color = OUTLINE_COLOR
						pair.Outline.Thickness = OUTLINE_THICKNESS
						pair.Outline.Transparency = 1
						pair.Outline.Visible = outlineOn

						pair.Fill.From = from
						pair.Fill.To = to
						pair.Fill.Color = color
						pair.Fill.Thickness = FILL_THICKNESS
						pair.Fill.Transparency = 1
						pair.Fill.Visible = true
					else
						pair.Outline.Visible = false
						pair.Fill.Visible = false
					end
				elseif pair then
					pair.Outline.Visible = false
					pair.Fill.Visible = false
				end
			end
		until true
	end
end

local PlayerOverlayESP = (function()

	local entries = {}
	local screenGui = nil
	local HEALTH_BAR_WIDTH = 2

	local DEFAULT_NAME_COLOR = Color3.new(1, 1, 1)
	local WHITELIST_COLOR = Color3.fromRGB(80, 255, 120)
	local TARGET_COLOR = Color3.fromRGB(255, 70, 70)
	local HEALTH_BG = Color3.new(0, 0, 0)
	local HEALTH_FILL = Color3.new(1, 1, 1)

	local function overlayParent()
		if typeof(gethui) == "function" then
			local ok, h = pcall(gethui)
			if ok and h then
				return h
			end
		end
		return game:GetService("CoreGui")
	end

	local function healthColorForPct(pct)
		if pct > 0.5 then
			return Color3.fromRGB(20, 170, 40):Lerp(Color3.fromRGB(180, 200, 40), (1 - pct) * 2)
		elseif pct > 0.3 then
			return Color3.fromRGB(180, 200, 40):Lerp(Color3.fromRGB(220, 140, 30), (0.5 - pct) * 5)
		end
		return Color3.fromRGB(220, 140, 30):Lerp(Color3.fromRGB(200, 40, 40), (0.3 - pct) * 3.33)
	end

	local function boxSolve(camera, root)
		local camCf = camera.CFrame
		local torsoPos = root.Position
		local up = root.CFrame.UpVector
		local topWorld = torsoPos + up * 1.8
		local bottomWorld = torsoPos - up * 2.5
		local distance = (torsoPos - camCf.Position).Magnitude

		local top, topOn = camera:WorldToViewportPoint(topWorld)
		local bottom, bottomOn = camera:WorldToViewportPoint(bottomWorld)
		if not topOn and not bottomOn then
			return nil, nil, false, distance
		end

		local width = math.max(math.floor(math.abs(top.X - bottom.X)), 3)
		local height = math.max(math.floor(math.max(math.abs(bottom.Y - top.Y), width / 2)), 3)
		local boxSize = Vector2.new(math.floor(math.max(height / 1.5, width)), height)
		local boxPos = Vector2.new(
			math.floor(top.X * 0.5 + bottom.X * 0.5 - boxSize.X * 0.5),
			math.floor(math.min(top.Y, bottom.Y))
		)
		return boxSize, boxPos, true, distance
	end

	local function ensureGui(): ScreenGui
		if screenGui and screenGui.Parent then
			return screenGui
		end

		local gui = Instance.new("ScreenGui")
		gui.Name = "FraudESP"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 999
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = overlayParent()
		screenGui = gui
		return gui
	end

	local function makeLabel(name)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.TextSize = 10
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = 0          
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.Visible = false

		if MinecraftiaFont then
			label.FontFace = MinecraftiaFont
		else
			label.Font = Enum.Font.GothamBold     
		end

		return label
	end

	local function createEntry(player): OverlayEntry
		local existing = entries[player]
		if existing then
			return existing
		end

		local gui = ensureGui()

		local holder = Instance.new("Frame")
		holder.Name = player.Name .. "_ESP"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Visible = false
		holder.Parent = gui

		local boxOuter = Instance.new("Frame")
		boxOuter.Name = "BoxOuter"
		boxOuter.BackgroundTransparency = 1
		boxOuter.BorderSizePixel = 0
		boxOuter.Size = UDim2.fromScale(1, 1)
		boxOuter.Visible = false
		boxOuter.Parent = holder

		local boxOutline = Instance.new("UIStroke")
		boxOutline.Name = "BoxOutline"
		boxOutline.Thickness = 1.5
		boxOutline.Color = Color3.new(0, 0, 0)
		boxOutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		boxOutline.Parent = boxOuter

		local boxInner = Instance.new("Frame")
		boxInner.Name = "BoxInner"
		boxInner.BackgroundTransparency = 1
		boxInner.BorderSizePixel = 0
		boxInner.Position = UDim2.fromOffset(1, 1)
		boxInner.Size = UDim2.new(1, -2, 1, -2)
		boxInner.Visible = false
		boxInner.Parent = holder

		local boxStroke = Instance.new("UIStroke")
		boxStroke.Name = "BoxStroke"
		boxStroke.Thickness = 1
		boxStroke.Color = Color3.new(1, 1, 1)
		boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		boxStroke.Parent = boxInner

		local name = makeLabel("Name")
		name.AnchorPoint = Vector2.new(0.5, 1)
		name.Position = UDim2.new(0.5, 0, 0, -2)
		name.Size = UDim2.new(1, 40, 0, 14)
		name.Parent = holder

		local distance = makeLabel("Distance")
		distance.AnchorPoint = Vector2.new(0.5, 0)
		distance.Position = UDim2.new(0.5, 0, 1, 2)
		distance.Size = UDim2.new(1, 40, 0, 12)
		distance.TextSize = 8
		distance.Parent = holder

		local weapon = makeLabel("Weapon")
		weapon.AnchorPoint = Vector2.new(0.5, 0)
		weapon.Position = UDim2.new(0.5, 0, 1, 16)
		weapon.Size = UDim2.new(1, 60, 0, 12)
		weapon.TextSize = 6
		weapon.Parent = holder

		local healthHolder = Instance.new("Frame")
		healthHolder.Name = "HealthHolder"
		healthHolder.AnchorPoint = Vector2.new(1, 0)
		healthHolder.Position = UDim2.new(0, -4, 0, 0)
		healthHolder.Size = UDim2.new(0, HEALTH_BAR_WIDTH, 1, 0)
		healthHolder.BackgroundColor3 = HEALTH_BG
		healthHolder.BorderSizePixel = 0
		healthHolder.Visible = false
		healthHolder.Parent = holder

		local healthFill = Instance.new("Frame")
		healthFill.Name = "HealthFill"
		healthFill.AnchorPoint = Vector2.new(0, 1)
		healthFill.Position = UDim2.fromScale(0, 1)
		healthFill.Size = UDim2.fromScale(1, 1)
		healthFill.BorderSizePixel = 0
		healthFill.BackgroundColor3 = Color3.new(1, 1, 1)
		healthFill.Parent = healthHolder

		local entry = {
			Holder = holder,
			BoxOuter = boxOuter,
			BoxStroke = boxStroke,
			BoxOutline = boxOutline,
			Name = name,
			Distance = distance,
			Weapon = weapon,
			HealthHolder = healthHolder,
			HealthFill = healthFill,
		}
		entries[player] = entry
		return entry
	end

	local function hideEntry(entry)
		entry.Holder.Visible = false
		entry.Name.Visible = false
		entry.Distance.Visible = false
		entry.Weapon.Visible = false
		entry.HealthHolder.Visible = false
		entry.BoxOuter.Visible = false
		if entry.BoxStroke.Parent then
			entry.BoxStroke.Parent.Visible = false
		end
	end

	local function destroyEntry(player)
		local entry = entries[player]
		if not entry then
			return
		end
		pcall(function()
			entry.Holder:Destroy()
		end)
		entries[player] = nil
	end

	local function hideAll()
		for _, entry in pairs(entries) do
			hideEntry(entry)
		end
	end

	local function overlayNeeded()
		if not SettingsManager.get(SettingsKeys.ESPEnabled) then
			return false
		end
		return SettingsManager.get(SettingsKeys.NameTags)
			or SettingsManager.get(SettingsKeys.ShowDistance)
			or SettingsManager.get(SettingsKeys.ToolESP)
			or SettingsManager.get(SettingsKeys.BoxESP)
			or SettingsManager.get(SettingsKeys.HealthBar)
	end

	local function update()
		if unloaded then
			return
		end

		if not overlayNeeded() then
			hideAll()
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then
			hideAll()
			return
		end

		local maxDist = SettingsManager.get(SettingsKeys.ESP_DISTANCE)
		local showName = SettingsManager.get(SettingsKeys.NameTags)
		local showDistance = SettingsManager.get(SettingsKeys.ShowDistance)
		local showTool = SettingsManager.get(SettingsKeys.ToolESP)
		local showBox = SettingsManager.get(SettingsKeys.BoxESP)
		local showHealth = SettingsManager.get(SettingsKeys.HealthBar)
		local boxColor = SettingsManager.get(SettingsKeys.BoxESPColor)

		local activePlayers = {}

		for _, player in ipairs(Players:GetPlayers()) do
			repeat
				if player == LocalPlayer then
					break
				end

				if not shouldShowESPForPlayer(player) then
					local stale = entries[player]
					if stale then
						hideEntry(stale)
					end
					break
				end

				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local root = character and character:FindFirstChild("HumanoidRootPart")

				if not character or not humanoid or not root or humanoid.Health <= 0 then
					local stale = entries[player]
					if stale then
						hideEntry(stale)
					end
					break
				end

				local boxSize, boxPos, onScreen, dist = boxSolve(camera, root)
				if not onScreen or not boxSize or not boxPos or dist > maxDist then
					local stale = entries[player]
					if stale then
						hideEntry(stale)
					end
					break
				end

				activePlayers[player] = true
				local entry = createEntry(player)

				entry.Holder.Position = UDim2.fromOffset(boxPos.X, boxPos.Y)
				entry.Holder.Size = UDim2.fromOffset(boxSize.X, boxSize.Y)
				entry.Holder.Visible = true

				if showName then
					entry.Name.Visible = true
					entry.Name.Text = player.DisplayName
					local nameColor = DEFAULT_NAME_COLOR
					if TargetListManager.isRageTarget(player.Name) then
						nameColor = TARGET_COLOR
					elseif TargetListManager.isWhitelisted(player.Name) then
						nameColor = WHITELIST_COLOR
					end
					entry.Name.TextColor3 = nameColor
				else
					entry.Name.Visible = false
				end

				if showDistance then
					entry.Distance.Visible = true
					entry.Distance.Text = math.floor(dist) .. " studs"
				else
					entry.Distance.Visible = false
				end

				if showTool then
					local tool = character:FindFirstChildOfClass("Tool")
					entry.Weapon.Visible = tool ~= nil
					entry.Weapon.Text = tool and tool.Name or ""
				else
					entry.Weapon.Visible = false
				end

				if showBox then
					entry.BoxOuter.Visible = true
					if entry.BoxStroke.Parent then
						entry.BoxStroke.Parent.Visible = true
					end
					entry.BoxStroke.Color = boxColor
				else
					entry.BoxOuter.Visible = false
					if entry.BoxStroke.Parent then
						entry.BoxStroke.Parent.Visible = false
					end
				end

				if showHealth then
					local pct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
					entry.HealthHolder.Visible = true
					entry.HealthFill.Size = UDim2.new(1, 0, pct, 0)
					entry.HealthFill.BackgroundColor3 = HEALTH_FILL
				else
					entry.HealthHolder.Visible = false
				end
			until true
		end

		for player, entry in pairs(entries) do
			if not activePlayers[player] then
				hideEntry(entry)
			end
		end
	end

	return {
		update = update,
		clearPlayer = destroyEntry,
		reset = function()
			for player in pairs(entries) do
				destroyEntry(player)
			end
			if screenGui then
				pcall(function()
					screenGui:Destroy()
				end)
