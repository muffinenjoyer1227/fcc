local function getDelayedTargetPosition(player, part, jumpDelayEnabled, jumpDelay)
	if not jumpDelayEnabled then
		return part.Position
	end

	local data = PlayerRegistry.get(player)
	if not data or not data.Root then
		return part.Position
	end

	local humanoid = data.Humanoid
	local root = data.Root

	if not humanoid or not root then
		return part.Position
	end

	local state = humanoid:GetState()
	local jumping =
		state == Enum.HumanoidStateType.Jumping or
		state == Enum.HumanoidStateType.Freefall or
		math.abs(root.AssemblyLinearVelocity.Y) > CONSTANTS.JUMP_VELOCITY_THRESHOLD

	local now = os.clock()
	local cache = PlayerRegistry.getJumpTrack(player)

	if jumping and not cache then
		PlayerRegistry.setJumpTrack(player, {
			startTime = now,
			lockedY = part.Position.Y,
		})
		cache = PlayerRegistry.getJumpTrack(player)
	end

	if not jumping then
		PlayerRegistry.clearJumpTrack(player)
		return part.Position
	end

	if cache and (now - cache.startTime) < jumpDelay then
		local t = (now - cache.startTime) / jumpDelay
		t = math.clamp(t, 0, 1)

		local current = part.Position
		local locked = Vector3.new(current.X, cache.lockedY, current.Z)
		return locked:Lerp(current, t)
	end

	return part.Position
end

