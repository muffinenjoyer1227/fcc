function SettingsManager.get(key)
	return settings[key]
end

function SettingsManager.set(key, value)
	local validated = validateSetting(key, value)
	if settings[key] == validated then
		return
	end
	settings[key] = validated
	for _, listener in settingsListeners do
		listener(key, validated)
	end
end

function SettingsManager.toggle(key)
	SettingsManager.set(key, not settings[key])
end

function SettingsManager.onChanged(callback)
	table.insert(settingsListeners, callback)
	local disconnected = false
	return function()
		if disconnected then return end
		disconnected = true
		local index = table.find(settingsListeners, callback)
		if index then
			table.remove(settingsListeners, index)
		end
	end
end

function SettingsManager.disconnectAll()
	for _, disconnect in settingsDisconnects do
		disconnect()
	end
	table.clear(settingsDisconnects)
	table.clear(settingsListeners)
end

local function trackSettingsListener(disconnect)
	table.insert(settingsDisconnects, disconnect)
end

