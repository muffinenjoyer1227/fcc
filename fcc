local function getSilentHitPart(character, partName)
	local part = character:FindFirstChild(partName)
	if part and part:IsA("BasePart") then return part end
	return character:FindFirstChild("Head")
end

local function isSilentValidTarget(player, data)
	if not isPlayerAlive(player) then return false end
	if SettingsManager.get(SettingsKeys.SilentAimTeamCheck)
		and player.Team == LocalPlayer.Team and player.Team ~= nil then
		return false
	end
	if SettingsManager.get(SettingsKeys.SilentAimWhitelistCheck)
		and TargetListManager.isWhitelisted(player.Name) then
		return false
	end
	if SettingsManager.get(SettingsKeys.SilentAimTargetCheck)
		and not TargetListManager.isRageTarget(player.Name) then
		return false
	end
	if SettingsManager.get(SettingsKeys.SilentAimForceFieldCheck)
		and data.Character:FindFirstChildOfClass("ForceField") then
		return false
	end
	if SettingsManager.get(SettingsKeys.SilentAimDownedCheck)
		and data.Humanoid and data.Humanoid.Health <= 15 then
		return false
	end
	return true
end

local function getSilentTarget()
	local camera = getCamera()
	local fov = SettingsManager.get(SettingsKeys.SilentAimFOV)
	local centerOnly = SettingsManager.get(SettingsKeys.SilentAimFOVCenterOnly)
	local mousePos = centerOnly
		and (camera.ViewportSize / 2)
		or UserInputService:GetMouseLocation()

	local useDist = SettingsManager.get(SettingsKeys.SilentAimUseDistance)
	local maxDist = SettingsManager.get(SettingsKeys.SilentAimMaxDistance)
	local wallCheck = SettingsManager.get(SettingsKeys.SilentAimWallCheck)
	local hitPartName = SettingsManager.get(SettingsKeys.SilentAimHitPart)

	local best = nil
	local bestDist = fov
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	PlayerRegistry.forEachEntry(function(player, data)
		if not isSilentValidTarget(player, data) then return end

		local part = getSilentHitPart(data.Character, hitPartName)
		if not part then return end

		if useDist and myRoot then
			if (part.Position - myRoot.Position).Magnitude > maxDist then return end
		end

		if wallCheck and not isCharacterVisible(data.Character, part, camera) then
			return
		end

		local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen or screenPos.Z <= 0 then return end

		local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
		if dist < bestDist then
			bestDist = dist
			best = part
		end
	end)

	return best
end

