end

local function onVisualize(_, shotCode, _, tool, _, origin, pelletDirections)
	drawTracerForVisualize(tool, origin, pelletDirections)

	if not SettingsManager.get(SettingsKeys.SilentAimEnabled) then return end
	if not tool then return end

	local char = LocalPlayer.Character
	if not char or char:FindFirstChildOfClass("ForceField") then return end

	local equipped = char:FindFirstChildOfClass("Tool")
	if equipped ~= tool then return end

	if math.random(1, 100) > SettingsManager.get(SettingsKeys.SilentAimHitChance) then return end

	local targetPart = SilentAimOwner.getTarget()
	if not targetPart or not targetPart.Parent then return end

	local hitRemote = game:GetService("ReplicatedStorage"):FindFirstChild("ZFKLF__H", true)
	if not hitRemote then return end

	local resolvedOrigin = getTracerOrigin(tool, typeof(origin) == "Vector3" and origin or nil)

	local pelletCount = type(pelletDirections) == "table" and math.max(1, #pelletDirections) or 1
	local dir = CFrame.new(resolvedOrigin, targetPart.Position).LookVector

	task.wait()

	for i = 1, pelletCount do
		pcall(function()
			hitRemote:FireServer(
				HIT_MARKER,
				tool,
				shotCode,
				i,
				targetPart,
				targetPart.Position,
				dir
			)
		end)
	end

	local hitMarker = tool:FindFirstChild("Hitmarker")
	if hitMarker then
		pcall(function() hitMarker:Fire(targetPart) end)
	end
end

