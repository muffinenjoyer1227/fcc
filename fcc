local GUN_SCAN_COOLDOWN = 2
local gunModulesCache = {}
local gunOriginalValues = {}

local NO_RECOIL_SETTING_KEYS = {
	SettingsKeys.NoRecoilEnabled,
	SettingsKeys.NoRecoil_Recoil,
	SettingsKeys.NoRecoil_Spread,
}

local function applyGunModuleValues()
	local noRecoilEnabled = SettingsManager.get(SettingsKeys.NoRecoilEnabled)
	local recoilPercent = SettingsManager.get(SettingsKeys.NoRecoil_Recoil) / 100
	local spreadPercent = SettingsManager.get(SettingsKeys.NoRecoil_Spread) / 100

	for moduleTable in pairs(gunModulesCache) do
		repeat
			local orig = gunOriginalValues[moduleTable]
			if not orig then break end

			if noRecoilEnabled then
				local recoil = orig.Recoil * recoilPercent
				local angleXMin = orig.AngleX_Min * recoilPercent
				local angleXMax = orig.AngleX_Max * recoilPercent
				local angleYMin = orig.AngleY_Min * recoilPercent
				local angleYMax = orig.AngleY_Max * recoilPercent
				local angleZMin = orig.AngleZ_Min * recoilPercent
				local angleZMax = orig.AngleZ_Max * recoilPercent
				local spread = orig.Spread * spreadPercent

				if moduleTable.Recoil ~= recoil then moduleTable.Recoil = recoil end
				if moduleTable.AngleX_Min ~= angleXMin then moduleTable.AngleX_Min = angleXMin end
				if moduleTable.AngleX_Max ~= angleXMax then moduleTable.AngleX_Max = angleXMax end
				if moduleTable.AngleY_Min ~= angleYMin then moduleTable.AngleY_Min = angleYMin end
				if moduleTable.AngleY_Max ~= angleYMax then moduleTable.AngleY_Max = angleYMax end
				if moduleTable.AngleZ_Min ~= angleZMin then moduleTable.AngleZ_Min = angleZMin end
				if moduleTable.AngleZ_Max ~= angleZMax then moduleTable.AngleZ_Max = angleZMax end
				if moduleTable.Spread ~= spread then moduleTable.Spread = spread end
			else
				if moduleTable.Recoil ~= orig.Recoil then moduleTable.Recoil = orig.Recoil end
				if moduleTable.AngleX_Min ~= orig.AngleX_Min then moduleTable.AngleX_Min = orig.AngleX_Min end
				if moduleTable.AngleX_Max ~= orig.AngleX_Max then moduleTable.AngleX_Max = orig.AngleX_Max end
				if moduleTable.AngleY_Min ~= orig.AngleY_Min then moduleTable.AngleY_Min = orig.AngleY_Min end
				if moduleTable.AngleY_Max ~= orig.AngleY_Max then moduleTable.AngleY_Max = orig.AngleY_Max end
				if moduleTable.AngleZ_Min ~= orig.AngleZ_Min then moduleTable.AngleZ_Min = orig.AngleZ_Min end
				if moduleTable.AngleZ_Max ~= orig.AngleZ_Max then moduleTable.AngleZ_Max = orig.AngleZ_Max end
				if moduleTable.Spread ~= orig.Spread then moduleTable.Spread = orig.Spread end
			end
		until true
	end
end

local function restoreGunModules()
	for moduleTable in pairs(gunModulesCache) do
		repeat
			local orig = gunOriginalValues[moduleTable]
			if not orig then break end

			moduleTable.Recoil = orig.Recoil
			moduleTable.AngleX_Min = orig.AngleX_Min
			moduleTable.AngleX_Max = orig.AngleX_Max
			moduleTable.AngleY_Min = orig.AngleY_Min
			moduleTable.AngleY_Max = orig.AngleY_Max
			moduleTable.AngleZ_Min = orig.AngleZ_Min
			moduleTable.AngleZ_Max = orig.AngleZ_Max
			moduleTable.Spread = orig.Spread
		until true
	end

	table.clear(gunModulesCache)
	table.clear(gunOriginalValues)
end

local function scanGunModules(forceScan)
	if not SettingsManager.get(SettingsKeys.NoRecoilEnabled) then
		applyGunModuleValues()
		return
	end

	local foundNew = false

	if typeof(getgc) == "function" and (forceScan or tick() - lastGunScanTime > GUN_SCAN_COOLDOWN) then
		lastGunScanTime = tick()

		for _, value in pairs(getgc(true)) do
			if type(value) == "table" and rawget(value, "EquipTime") then
				if not gunModulesCache[value] then
					foundNew = true
					gunModulesCache[value] = true

					if not gunOriginalValues[value] then
						gunOriginalValues[value] = {
							Recoil = value.Recoil or 0,
							AngleX_Min = value.AngleX_Min or 0,
							AngleX_Max = value.AngleX_Max or 0,
							AngleY_Min = value.AngleY_Min or 0,
							AngleY_Max = value.AngleY_Max or 0,
							AngleZ_Min = value.AngleZ_Min or 0,
							AngleZ_Max = value.AngleZ_Max or 0,
							Spread = value.Spread or 0,
						}
					end
				end
			end
		end
	end

	if foundNew or forceScan then
		applyGunModuleValues()
	end
end

