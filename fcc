end))

local NoFallDamageOwner = (function()
	local ff = nil
	local charConn = nil
	local heartbeatConn = nil
	local namecallHooked = false
	local oldNamecall = nil

	local function removeFF()
		if ff then
			pcall(function() ff:Destroy() end)
			ff = nil
		end
	end

	local function applyFF(character)
		removeFF()
		if not character then return end
		local forceField = Instance.new("ForceField")
		forceField.Visible = false
		forceField.Parent = character
		ff = forceField
	end

	local function installHook()
		if namecallHooked then return end
		if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then
			return
		end

		task.spawn(function()
			local events = ReplicatedStorage:FindFirstChild("Events")
			local fallEvent = events and events:FindFirstChild("__RZDONL")
			if not fallEvent and events then
				fallEvent = events:WaitForChild("__RZDONL", 10)
			end
			if not fallEvent or namecallHooked then return end

			namecallHooked = true
			oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
				local method = getnamecallmethod()
				if method == "FireServer" and self == fallEvent then
					if SettingsManager.get(SettingsKeys.NoFallDamageEnabled)
						and SettingsManager.get(SettingsKeys.NoFallDamageMethod) == "Block Remote" then
						local args = { ... }
						if args[1] == "FlllD" or args[1] == "FllH" then
							return 
						end
					end
				end
				return oldNamecall(self, ...)
			end)
		end)
	end

	local function stopForceFieldMode()
		removeFF()
		if charConn then
			charConn:Disconnect()
			charConn = nil
		end
		if heartbeatConn then
			heartbeatConn:Disconnect()
			heartbeatConn = nil
		end
	end

	local function startForceFieldMode()
		stopForceFieldMode()
		applyFF(LocalPlayer.Character)

		charConn = LocalPlayer.CharacterAdded:Connect(function(char)
			if SettingsManager.get(SettingsKeys.NoFallDamageEnabled)
				and SettingsManager.get(SettingsKeys.NoFallDamageMethod) == "ForceField" then
				applyFF(char)
			end
		end)

		heartbeatConn = RunService.Heartbeat:Connect(function()
			if unloaded then return end
			if not SettingsManager.get(SettingsKeys.NoFallDamageEnabled) then return end
			if SettingsManager.get(SettingsKeys.NoFallDamageMethod) ~= "ForceField" then return end

			local char = LocalPlayer.Character
			if not char then return end
			local existing = char:FindFirstChildOfClass("ForceField")
			if not existing or existing ~= ff then
				applyFF(char)
			end
		end)
	end

	local function apply()
		local enabled = SettingsManager.get(SettingsKeys.NoFallDamageEnabled) == true
		local method = SettingsManager.get(SettingsKeys.NoFallDamageMethod)

		if enabled then
			installHook() 
			if method == "ForceField" then
				startForceFieldMode()
			else
				stopForceFieldMode()
			end
		else
			stopForceFieldMode()
		end
	end

	return {
		apply = apply,
		reset = function()
			stopForceFieldMode()
		end,
	}
end)()

