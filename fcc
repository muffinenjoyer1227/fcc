local BulletTracerOwner = (function()
	local MAX_BULLET_BEAMS = 30
	local MIN_BULLET_BEAM_DISTANCE = 0.1

	local DNA_TEX = "rbxassetid://7071778278"
	local DNA_LEN = 12
	local DNA_SPD = 1
	local DNA_W0 = 0.6
	local DNA_W1 = 0.6

	local live = {}

	local function destroyEntry(entry)
		pcall(function() entry.Beam:Destroy() end)
		pcall(function() entry.Attachment0:Destroy() end)
		pcall(function() entry.Attachment1:Destroy() end)
	end

	local function trimBeams()
		while #live >= MAX_BULLET_BEAMS do
			local oldest = table.remove(live, 1)
			if oldest then
				destroyEntry(oldest)
			end
		end
	end

	return {
		createBeam = function(from, to)
			if unloaded then return end
			if not SettingsManager.get(SettingsKeys.BulletTracerEnabled) then return end
			if (from - to).Magnitude < MIN_BULLET_BEAM_DISTANCE then return end

			trimBeams()

			local parent = workspace.Terrain

			local att0 = Instance.new("Attachment")
			att0.WorldPosition = from
			att0.Parent = parent

			local att1 = Instance.new("Attachment")
			att1.WorldPosition = to
			att1.Parent = parent

			local beam = Instance.new("Beam")
			beam.Attachment0 = att0
			beam.Attachment1 = att1
			beam.FaceCamera = true
			beam.LightEmission = 0.5
			beam.LightInfluence = 0.1

			local color = SettingsManager.get(SettingsKeys.BulletTracerColor)
			beam.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color),
				ColorSequenceKeypoint.new(1, color),
			})

			local thickness = SettingsManager.get(SettingsKeys.BulletTracerThickness)
			local scale = thickness / 0.1 
			beam.Width0 = DNA_W0 * scale
			beam.Width1 = DNA_W1 * scale

			local transparency = SettingsManager.get(SettingsKeys.BulletTracerTransparency)
			beam.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, transparency * 0.5),
				NumberSequenceKeypoint.new(0.5, transparency),
				NumberSequenceKeypoint.new(1, 1),
			})

			beam.Texture = DNA_TEX
			beam.TextureLength = DNA_LEN
			beam.TextureSpeed = DNA_SPD
			beam.TextureMode = Enum.TextureMode.Wrap
			beam.Segments = 1
			beam.Parent = parent

			local entry = {
				Beam = beam,
				Attachment0 = att0,
				Attachment1 = att1,
			}
			table.insert(live, entry)

			local lifetime = SettingsManager.get(SettingsKeys.BulletTracerLifetime)
			local startT = os.clock()
			local baseT = transparency

			task.spawn(function()
				while not unloaded and beam.Parent do
					local elapsed = os.clock() - startT
					local alpha = math.clamp(elapsed / lifetime, 0, 1)
					local t = baseT + (1 - baseT) * (alpha * alpha)
					beam.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.min(1, t * 0.5 + alpha * 0.5)),
						NumberSequenceKeypoint.new(0.5, math.min(1, t)),
						NumberSequenceKeypoint.new(1, 1),
					})
					local wScale = 1 - alpha * 0.85
					beam.Width0 = DNA_W0 * scale * wScale
					beam.Width1 = DNA_W1 * scale * wScale

					if alpha >= 1 then
						break
					end
					task.wait()
				end

				local index = table.find(live, entry)
				if index then
					table.remove(live, index)
				end
				destroyEntry(entry)
			end)
		end,
		clearPlayer = function(_player)
		end,
		reset = function()
			for _, entry in ipairs(live) do
				destroyEntry(entry)
			end
			table.clear(live)
		end,
	}
end)()

local TRACE_DIST = 500

local function isLocalPlayerTool(tool)
	if not tool or not tool:IsA("Tool") then
		return false
	end
	local character = LocalPlayer.Character
	if not character then
		return false
	end
	if tool.Parent == character or tool:IsDescendantOf(character) then
		return true
	end
	return false
end

local function getTracerOrigin(tool, fallback)
	if typeof(fallback) == "Vector3" then
		return fallback
	end
	if tool then
		local handle = tool:FindFirstChild("WeaponHandle", true) or tool:FindFirstChild("Handle", true)
		local firePoint = handle and (handle:FindFirstChild("FirePoint", true) or handle:FindFirstChild("Muzzle", true))
		if firePoint then
			return firePoint:IsA("Attachment") and firePoint.WorldPosition or firePoint.Position
		end
	end
	return getCamera().CFrame.Position
end

local function traceBulletDirections(tool, directions, originArg)
	if not SettingsManager.get(SettingsKeys.BulletTracerEnabled) then return end
	if not isLocalPlayerTool(tool) then return end
	if type(directions) ~= "table" then return end

	local origin = getTracerOrigin(tool, typeof(originArg) == "Vector3" and originArg or nil)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local char = LocalPlayer.Character
	params.FilterDescendantsInstances = char and { char } or {}

	for _, dir in directions do
		repeat
			if typeof(dir) ~= "Vector3" or dir.Magnitude < 1e-3 then break end
			local unit = dir.Unit
			local endPos = origin + unit * TRACE_DIST
			local hit = workspace:Raycast(origin, unit * TRACE_DIST, params)
			if hit then endPos = hit.Position end
			BulletTracerOwner.createBeam(origin, endPos)
		until true
	end
end

