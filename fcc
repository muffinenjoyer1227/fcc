local MeleeAuraOwner = (function()
	local connection = nil
	local lastAttack = 0
	local ATTACK_COOLDOWN = 0.35 

	local BREAD = "\240\159\141\158" 

	local function findMeleeRemotes()
		local events = ReplicatedStorage:FindFirstChild("Events")
		if not events then return nil, nil end
		local swing = events:FindFirstChild("XMHH.2")
		local hit = events:FindFirstChild("XMHH2.2")
		if swing and not swing:IsA("RemoteFunction") and not swing:IsA("RemoteEvent") then
			swing = nil
		end
		if hit and not hit:IsA("RemoteEvent") then
			hit = nil
		end
		return swing, hit
	end

	local function isValidTarget(player)
		if player == LocalPlayer then return false end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local head = character and character:FindFirstChild("Head")
		if not character or not humanoid or not root or not head then return false end
		if humanoid.Health <= 15 then return false end
		if character:FindFirstChildOfClass("ForceField") then return false end

		if SettingsManager.get(SettingsKeys.MeleeAuraTeamCheck)
			and player.Team ~= nil
			and LocalPlayer.Team ~= nil
			and player.Team == LocalPlayer.Team then
			return false
		end

		if SettingsManager.get(SettingsKeys.MeleeAuraWhitelistCheck)
			and TargetListManager.isWhitelisted(player.Name) then
			return false
		end

		if SettingsManager.get(SettingsKeys.MeleeAuraTargetCheck)
			and not TargetListManager.isRageTarget(player.Name) then
			return false
		end

		return true
	end

	local function attack(targetCharacter)
		local swingRemote, hitRemote = findMeleeRemotes()
		if not swingRemote or not hitRemote then return end

		local character = LocalPlayer.Character
		if not character then return end
		local tool = character:FindFirstChildOfClass("Tool")
		local localRoot = character:FindFirstChild("HumanoidRootPart")
		local head = targetCharacter:FindFirstChild("Head")
		if not tool or not localRoot or not head then return end

		local ok, result = pcall(function()
			return swingRemote:InvokeServer(
				BREAD,
				tick(),
				tool,
				"43TRFWX",
				"Normal",
				tick(),
				true
			)
		end)
		if not ok then return end

		task.wait(0.3)

		tool = character:FindFirstChildOfClass("Tool")
		if not tool then return end

		local handle = tool:FindFirstChild("WeaponHandle")
			or tool:FindFirstChild("Handle")
			or character:FindFirstChild("Right Arm")
			or character:FindFirstChild("RightHand")
		if not handle or not head.Parent then return end

		pcall(function()
			hitRemote:FireServer(
				BREAD,
				tick(),
				tool,
				"2389ZFX34",
				result,
				false,
				handle,
				head,
				targetCharacter,
				localRoot.Position,
				head.Position
			)
		end)
	end

	local function step()
		if unloaded then return end
		if not SettingsManager.get(SettingsKeys.MeleeAuraEnabled) then return end
		if tick() - lastAttack < ATTACK_COOLDOWN then return end

		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local tool = character and character:FindFirstChildOfClass("Tool")
		if not root or not tool then return end

		local range = SettingsManager.get(SettingsKeys.MeleeAuraRange)
		local best = nil
		local bestDist = range

		for _, player in ipairs(Players:GetPlayers()) do
			if isValidTarget(player) then
				local targetRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					local dist = (root.Position - targetRoot.Position).Magnitude
					if dist < bestDist then
						bestDist = dist
						best = player.Character
					end
				end
			end
		end

		if best then
			lastAttack = tick()
			task.spawn(attack, best)
		end
	end

	return {
		start = function()
			if connection then return end
			connection = RunService.Heartbeat:Connect(step)
		end,
		stop = function()
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end,
		reset = function()
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end,
	}
end)()

