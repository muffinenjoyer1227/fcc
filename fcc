	local fovOutline = nil
	local fovFill = nil
	local fovConnection = nil
	local fireRemote = nil
	local hitRemote = nil
	local reloadRemote = nil
	local tpConnection = nil

	local function findRageRemotes()
		if fireRemote and hitRemote and reloadRemote then
			return
		end

		local events = ReplicatedStorage:FindFirstChild("Events")
		fireRemote = fireRemote or (events and events:FindFirstChild("GNX_S"))
			or ReplicatedStorage:FindFirstChild("GNX_S", true)
		hitRemote = hitRemote or (events and events:FindFirstChild("ZFKLF__H"))
			or ReplicatedStorage:FindFirstChild("ZFKLF__H", true)
		reloadRemote = reloadRemote or (events and events:FindFirstChild("GNX_R"))
			or ReplicatedStorage:FindFirstChild("GNX_R", true)

		if fireRemote and not fireRemote:IsA("RemoteEvent") then fireRemote = nil end
		if hitRemote and not hitRemote:IsA("RemoteEvent") then hitRemote = nil end
		if reloadRemote and not reloadRemote:IsA("RemoteEvent") then reloadRemote = nil end
	end

	local function getRageCharacter(player)
		return player and player.Character
	end

	local function getRageHumanoid(player)
		local character = getRageCharacter(player)
		return character and character:FindFirstChildOfClass("Humanoid")
	end

	local function getRageRootPart(player)
		local character = getRageCharacter(player)
		return character and character:FindFirstChild("HumanoidRootPart")
	end

	local function isRagePlayerDowned(player)
		local succeeded, downed = pcall(function()
			return ReplicatedStorage.CharStats[player.Name].Downed.Value
		end)
		return succeeded and downed == true
	end

	local function shouldIgnoreRagePlayer(player, rageSettings)
		if not player or player == LocalPlayer then
			return true
		end

		local character = getRageCharacter(player)
		local humanoid = getRageHumanoid(player)
		if not character or not humanoid or humanoid.Health <= 0 then
			return true
		end

		if rageSettings.CheckTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
			return true
		end

		if rageSettings.CheckWhitelist and TargetListManager.isWhitelisted(player.Name) then
			return true
		end

		if rageSettings.CheckTarget and not TargetListManager.isRageTarget(player.Name) then
			return true
		end

		if rageSettings.CheckDown and isRagePlayerDowned(player) then
			return true
		end

		if rageSettings.CheckForceShield and character:FindFirstChildOfClass("ForceField") then
			return true
		end

		return false
	end

	local function getClosestTargetListPlayer()
		local localRoot = getRageRootPart(LocalPlayer)
		if not localRoot then return nil end

		local best = nil
		local bestDist = math.huge

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and TargetListManager.isRageTarget(player.Name) then
				local character = getRageCharacter(player)
				local humanoid = getRageHumanoid(player)
				local root = getRageRootPart(player)
				if character and humanoid and root and humanoid.Health > 0 then
					if not character:FindFirstChildOfClass("ForceField") then
						if not (SettingsManager.get(SettingsKeys.RagebotTeamCheck)
							and player.Team and LocalPlayer.Team
							and player.Team == LocalPlayer.Team)
						then
							if not (SettingsManager.get(SettingsKeys.RagebotWhitelistCheck)
								and TargetListManager.isWhitelisted(player.Name))
							then
								if not (SettingsManager.get(SettingsKeys.RagebotDownedCheck)
									and isRagePlayerDowned(player))
								then
									local dist = (root.Position - localRoot.Position).Magnitude
									if dist < bestDist then
										bestDist = dist
										best = player
									end
								end
							end
						end
					end
				end
			end
		end

		return best
	end

	local function stopTPTarget()
		if tpConnection then
			tpConnection:Disconnect()
			tpConnection = nil
		end
	end

	local function startTPTarget()
		stopTPTarget()
		tpConnection = RunService.RenderStepped:Connect(function()
			if unloaded then return end
			if not SettingsManager.get(SettingsKeys.RagebotEnabled) then return end
			if not SettingsManager.get(SettingsKeys.RagebotTPTarget) then return end

			local myRoot = getRageRootPart(LocalPlayer)
			if not myRoot then return end

			local target = getClosestTargetListPlayer()
			if not target then return end

			local targetRoot = getRageRootPart(target)
			if not targetRoot then return end

			myRoot.CFrame = CFrame.new(
				targetRoot.Position - (targetRoot.CFrame.LookVector * 3),
				targetRoot.Position
			)
		end)
	end

	local function getRageTargetPart(character, partName, targetBodyParts)
		if not character then
			return nil
		end

		if partName ~= "Random" then
			local targetPart = character:FindFirstChild(partName)
			if targetPart and targetPart:IsA("BasePart") then
				return targetPart
			end
		end

		local candidates: {BasePart} = {}
		for _, currentName in ipairs(targetBodyParts) do
			local targetPart = character:FindFirstChild(currentName)
			if targetPart and targetPart:IsA("BasePart") then
				table.insert(candidates, targetPart)
			end
		end

		if #candidates > 0 then
			return candidates[math.random(1, #candidates)]
		end

		return nil
	end

	local function projectRageToScreen(part): (Vector2, boolean)
		local camera = getCamera()
		local viewportPoint, isVisible = camera:WorldToViewportPoint(part.Position)
		return Vector2.new(viewportPoint.X, viewportPoint.Y), isVisible and viewportPoint.Z > 0
	end

	local function getRageScreenCenter(rageSettings)
		local camera = getCamera()
		if rageSettings.CircleCenterOnly then
			return Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
		end
		return UserInputService:GetMouseLocation()
	end

	local function createShotIdentifier()
		local currentValues = table.create(31)
		for currentIndex = 1, 30 do
			currentValues[currentIndex] = string.char(math.random(97, 122))
		end
		currentValues[31] = "0"
		return table.concat(currentValues)
	end

	local function buildRageSettings()
		return {
			CheckDown = SettingsManager.get(SettingsKeys.RagebotDownedCheck),
			CheckTeam = SettingsManager.get(SettingsKeys.RagebotTeamCheck),
			WallCheck = SettingsManager.get(SettingsKeys.RagebotWallCheck),
			FindType = SettingsManager.get(SettingsKeys.RagebotFindType),
			MaxDistance = SettingsManager.get(SettingsKeys.RagebotMaxDistance),
			CircleRadius = SettingsManager.get(SettingsKeys.RagebotCircleRadius),
			CheckWhitelist = SettingsManager.get(SettingsKeys.RagebotWhitelistCheck),
			CheckTarget = SettingsManager.get(SettingsKeys.RagebotTargetCheck),
			CheckForceShield = SettingsManager.get(SettingsKeys.RagebotForceShieldCheck),
			CircleCenterOnly = SettingsManager.get(SettingsKeys.RagebotCircleCenterOnly),
			HitPart = SettingsManager.get(SettingsKeys.RagebotHitPart),
			LockedTarget = lockedTarget,
		}
	end

	local function selectRageTarget(rageSettings, targetBodyParts, mode)
		local bestPlayer = nil
		local bestTargetPart = nil
		local bestScore = math.huge
		local screenCenter = getRageScreenCenter(rageSettings)
		local localRootPart = getRageRootPart(LocalPlayer)

		for _, currentPlayer in ipairs(Players:GetPlayers()) do
			if not shouldIgnoreRagePlayer(currentPlayer, rageSettings) then
				local character = getRageCharacter(currentPlayer)
				local part = character and getRageTargetPart(character, rageSettings.HitPart or "Head", targetBodyParts)
				if part then
					local projectedPosition, isOnScreen = projectRageToScreen(part)
					if isOnScreen then
						local screenDistance = (projectedPosition - screenCenter).Magnitude
						local targetDistance = localRootPart and (part.Position - localRootPart.Position).Magnitude or math.huge
						local score = nil

						if mode == "Distance" then
							if targetDistance <= (rageSettings.MaxDistance or math.huge) then
								score = targetDistance
							end
						elseif mode == "Circle" then
							if screenDistance <= (rageSettings.CircleRadius or 120) then
								score = screenDistance
							end
						else
							if screenDistance <= (rageSettings.CircleRadius or 120) then
								score = screenDistance
							end
						end

						if score and score < bestScore then
							bestScore = score
							bestPlayer = currentPlayer
							bestTargetPart = part
						end
					end
				end
			end
		end

		return bestPlayer, bestTargetPart
	end

	local function createDrawingCircle(fill, zIndex, color)
		local drawingObject = Drawing.new("Circle")
		drawingObject.Visible = false
		drawingObject.Filled = fill
		drawingObject.Color = color
		drawingObject.Thickness = 1
		drawingObject.Transparency = fill and 0.85 or 1
		drawingObject.NumSides = 64
		drawingObject.Radius = 120
		drawingObject.ZIndex = zIndex
		return drawingObject
	end

	local function ensureFOVDrawings()
		if not fovOutline then
			fovOutline = createDrawingCircle(false, 995, SettingsManager.get(SettingsKeys.RagebotCircleColor))
		end
		if not fovFill then
			fovFill = createDrawingCircle(true, 994, SettingsManager.get(SettingsKeys.RagebotFillColor))
		end
	end

	local function updateFOV()
		local showCircle = SettingsManager.get(SettingsKeys.RagebotShowFOV)
		local findType = SettingsManager.get(SettingsKeys.RagebotFindType)
		local rageSettings = buildRageSettings()

		if not showCircle or findType ~= "Circle" then
			if fovOutline then fovOutline.Visible = false end
			if fovFill then fovFill.Visible = false end
			return
		end

		ensureFOVDrawings()
		local center = getRageScreenCenter(rageSettings)
		local radius = SettingsManager.get(SettingsKeys.RagebotCircleRadius)
		local lockedColor = SettingsManager.get(SettingsKeys.RagebotLockedColor)
		local circleColor = SettingsManager.get(SettingsKeys.RagebotCircleColor)
		local fillColor = SettingsManager.get(SettingsKeys.RagebotFillColor)
		local fillCircle = SettingsManager.get(SettingsKeys.RagebotFillCircle)

		if fovOutline then
			fovOutline.Position = center
			fovOutline.Radius = radius
			fovOutline.Color = lockedTarget and lockedColor or circleColor
			fovOutline.Visible = true
		end

		if fovFill then
			fovFill.Position = center
			fovFill.Radius = radius
			fovFill.Color = fillColor
			fovFill.Visible = fillCircle
		end
	end

	local function destroyFOVDrawings()
		if fovOutline then
			pcall(function() fovOutline:Remove() end)
			fovOutline = nil
		end
		if fovFill then
			pcall(function() fovFill:Remove() end)
			fovFill = nil
		end
	end

	local function updateHighlight(character)
		if not SettingsManager.get(SettingsKeys.RagebotHighlight) then
			if highlight then
				highlight.Enabled = false
			end
			return
		end

		if not highlight then
			local hl = Instance.new("Highlight")
			hl.Name = "RagebotHighlight"
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.FillTransparency = 0.6
			hl.OutlineTransparency = 0.2
			hl.Parent = game:GetService("CoreGui")
			highlight = hl
		end

		highlight.FillColor = SettingsManager.get(SettingsKeys.RagebotHighlightColor)
		highlight.OutlineColor = SettingsManager.get(SettingsKeys.RagebotHighlightColor)
		highlight.Adornee = character
		highlight.Enabled = character ~= nil
	end

	local SW_RADIUS = 19
	local SW_POINTS = 40

	local function generate_femboy_fibonacci_offsets(radius, num_points)
		local offsets = {}
		local phi = (1 + math.sqrt(5)) / 2
		local angle_increment = math.pi * 2 * phi
		for i = 0, num_points - 1 do
			local t = i / num_points
			local inclination = math.acos(1 - 2 * t)
			local azimuth = angle_increment * i
			local x = math.sin(inclination) * math.cos(azimuth)
			local y = math.sin(inclination) * math.sin(azimuth)
			local z = math.cos(inclination)
			offsets[#offsets + 1] = Vector3.new(x * radius, y * radius, z * radius)
		end
		return offsets
	end

	local function getFemboyOffsets()
		local R = math.clamp(SW_RADIUS, 1, 19)
		local offsets = generate_femboy_fibonacci_offsets(R, SW_POINTS)
		table.insert(offsets, 1, Vector3.zero)
		return offsets
	end

	local function is_femboy_path_clear(from_pos, to_pos, ignore_list)
		local direction = to_pos - from_pos
		local mag = direction.Magnitude
		if mag < 1e-4 then
			return false
		end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = ignore_list
		rp.IgnoreWater = true
		return workspace:Raycast(from_pos, direction.Unit * mag, rp) == nil
	end

	local function findClearShot(
		localRoot,
		targetPlayer,
		targetCharacter,
		preferredHitPart
	)
		local camera = getCamera()
		local localChar = getRageCharacter(LocalPlayer)
		local ignore = { camera, localChar, targetCharacter }

		local priority_parts = {}
		for _, name in ipairs({ "Head", "UpperTorso", "HumanoidRootPart", "Torso" }) do
			local p = targetCharacter:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				table.insert(priority_parts, p)
			end
		end
		if #priority_parts == 0 then
			table.insert(priority_parts, preferredHitPart)
		end

		local femboy_offsets = getFemboyOffsets()

		for _, shoot_offset in ipairs(femboy_offsets) do
			local shoot_pos = localRoot.Position + shoot_offset
			for _, part in ipairs(priority_parts) do
				if part and part.Parent then
					for _, hit_offset in ipairs(femboy_offsets) do
						local hit_pos = part.Position + hit_offset
						if is_femboy_path_clear(shoot_pos, hit_pos, ignore) then
							-- priv13: direction = unit * 1000
							local dir = (hit_pos - shoot_pos).Unit * 1000
							return shoot_pos, part, hit_pos, dir
						end
					end
				end
			end
		end

		return nil, nil, nil, nil
	end

	local function fireRageShot(targetPlayer, part)
		findRageRemotes()
		if not fireRemote or not hitRemote then
			return
		end

		local character = getRageCharacter(LocalPlayer)
		local rootPart = getRageRootPart(LocalPlayer)
		local tool = character and character:FindFirstChildOfClass("Tool")
		local vals = tool and tool:FindFirstChild("Values")
		local ammo = vals and vals:FindFirstChild("SERVER_Ammo")

		if not character or not rootPart or not tool or not tool:FindFirstChild("Hitmarker") then
			return
		end

		if not SettingsManager.get(SettingsKeys.RagebotBeastMode) then
			if not ammo or ammo.Value <= 0 then
				return
			end
		end

		local targetCharacter = targetPlayer.Character
		if not targetCharacter or not part.Parent then
			return
		end

		local useSmartWall = SettingsManager.get(SettingsKeys.RagebotWallCheck)
		local origin
		local hitPart
		local hitPos
		local dir

		if useSmartWall then
			local clearOrigin, clearHitPart, clearHitPos, clearDir =
				findClearShot(rootPart, targetPlayer, targetCharacter, part)
			if not clearOrigin or not clearHitPart or not clearHitPos or not clearDir then
				return
			end
			origin = clearOrigin
			hitPart = targetCharacter:FindFirstChild("Head") or clearHitPart
			hitPos = clearHitPos
			dir = clearDir
		else
			origin = rootPart.Position + Vector3.new(math.random(-18, 18), math.random(-18, 18), math.random(-18, 18))
			hitPart = part
			hitPos = part.Position
			local toTarget = hitPos - origin
			if toTarget.Magnitude < 1e-3 then
				return
			end
			dir = toTarget.Unit
		end

		local shotId = createShotIdentifier()

		pcall(function()
			fireRemote:FireServer(tick(), shotId, tool, "FDS9I83", origin, { dir }, false)
		end)

		local shootSpeed = SettingsManager.get(SettingsKeys.RagebotShootDelay)
		if shootSpeed > 0 and not SettingsManager.get(SettingsKeys.RagebotBeastMode) then
			task.wait(shootSpeed)
		end

		pcall(function()
			hitRemote:FireServer(HIT_MARKER, tool, shotId, 1, hitPart, hitPos, dir)
		end)

		if reloadRemote then
			pcall(function()
				reloadRemote:FireServer(tick(), "KLWE89U0", tool)
			end)
		end

		local hitMarker = tool:FindFirstChild("Hitmarker")
		if hitMarker then
			pcall(function()
				hitMarker:Fire(hitPart)
			end)
		end

		if SettingsManager.get(SettingsKeys.BulletTracerEnabled) then
			BulletTracerOwner.createBeam(origin, hitPos)
		end

		if SettingsManager.get(SettingsKeys.RagebotNotifyHit) then
			local humanoid = getRageHumanoid(targetPlayer)
			Library:Notify(
				targetPlayer.Name .. " : Hit | HP " .. tostring(humanoid and math.floor(humanoid.Health) or 0),
				2
			)
		end
	end

	local function ensureFOVConnection()
		if fovConnection then return end
		fovConnection = RunService.RenderStepped:Connect(function()
			if unloaded then return end
			updateFOV()
		end)
	end

	task.defer(ensureFOVConnection)

	local function disconnectFOVConnection()
		if fovConnection then
			fovConnection:Disconnect()
			fovConnection = nil
		end
	end

	return {
		updateHighlight = updateHighlight,
		start = function()
			if currentTask then
				pcall(function()
					task.cancel(currentTask)
				end)
				currentTask = nil
			end

			ensureFOVConnection()
			runId = runId + 1
			local myRunId = runId
			currentTask = task.spawn(function()
				while myRunId == runId
					and SettingsManager.get(SettingsKeys.RagebotEnabled)
					and not unloaded do
					local rageSettings = buildRageSettings()
					local targetPlayer, part = selectRageTarget(rageSettings, RAGE_TARGET_BODY_PARTS, rageSettings.FindType)
					lockedTarget = targetPlayer
					updateHighlight(targetPlayer and targetPlayer.Character or nil)

					if targetPlayer and part then
						pcall(fireRageShot, targetPlayer, part)
					end

					if SettingsManager.get(SettingsKeys.RagebotWallCheck) then
						task.wait(0.015)
					else
						task.wait()
					end
				end

				if myRunId == runId then
					lockedTarget = nil
					updateHighlight(nil)
					currentTask = nil
				end
			end)

			if SettingsManager.get(SettingsKeys.RagebotTPTarget) then
				startTPTarget()
			end
		end,
		stop = function()
			runId = runId + 1
			if currentTask then
				pcall(function()
					task.cancel(currentTask)
				end)
				currentTask = nil
			end
			stopTPTarget()
			lockedTarget = nil
			updateHighlight(nil)
			updateFOV()
		end,
		clearPlayer = function(player)
			if lockedTarget == player then
				lockedTarget = nil
			end
			if highlight and highlight.Enabled and highlight.Adornee then
				local targetPlayer = Players:GetPlayerFromCharacter(highlight.Adornee)
				if targetPlayer == player then
					updateHighlight(nil)
				end
			end
		end,
		reset = function()
			runId = runId + 1
			if currentTask then
				pcall(function()
					task.cancel(currentTask)
				end)
				currentTask = nil
			end
			stopTPTarget()
			lockedTarget = nil
			disconnectFOVConnection()
			destroyFOVDrawings()
			if highlight then
				pcall(function() highlight:Destroy() end)
				highlight = nil
			end
		end,
		setTPTarget = function(enabled)
			if enabled and SettingsManager.get(SettingsKeys.RagebotEnabled) then
				startTPTarget()
			else
				stopTPTarget()
			end
		end,
	}
end)()

local function SetRagebotEnabled(value)
	if value then
		RagebotOwner.start()
	else
		RagebotOwner.stop()
	end
end

trackSettingsListener(SettingsManager.onChanged(function(key, value)
	if key == SettingsKeys.RagebotEnabled then
		SetRagebotEnabled(value == true)
	elseif key == SettingsKeys.RagebotTPTarget then
		RagebotOwner.setTPTarget(value == true)
	elseif key == SettingsKeys.RagebotHighlight and value ~= true then
		RagebotOwner.updateHighlight(nil)
	elseif key == SettingsKeys.RagebotHighlightColor then
		RagebotOwner.updateHighlight(nil)
	end
end))

local SilentAimOwner = (function()
	local target = nil
	local fovCircle = nil
	local fovFill = nil
	local heartbeat = nil

	local function removeFOV()
		if fovCircle then
			pcall(function() fovCircle:Remove() end)
			fovCircle = nil
		end
		if fovFill then
			pcall(function() fovFill:Remove() end)
			fovFill = nil
		end
	end

	return {
		getTarget = function()
			return target
		end,
		setTarget = function(part)
			target = part
		end,
		clearTarget = function()
			target = nil
		end,
		clearPlayer = function(player)
			if target and target.Parent then
				local owner = Players:GetPlayerFromCharacter(target.Parent)
				if owner == player then
					target = nil
				end
			end
		end,
		updateFOV = function()
			local draw = SettingsManager.get(SettingsKeys.SilentAimDrawFOV)
			local fill = SettingsManager.get(SettingsKeys.SilentAimFOVFill)
			local fov = SettingsManager.get(SettingsKeys.SilentAimFOV)
			local centerOnly = SettingsManager.get(SettingsKeys.SilentAimFOVCenterOnly)
			local camera = getCamera()
			local pos = centerOnly
				and (camera.ViewportSize / 2)
				or UserInputService:GetMouseLocation()

			if not draw then
				if fovCircle then fovCircle.Visible = false end
				if fovFill then fovFill.Visible = false end
				return
			end

			if not fovCircle then
				local ok, circle = pcall(Drawing.new, "Circle")
				if ok and circle then
					circle.Thickness = 1.5
					circle.Filled = false
					circle.NumSides = 64
					fovCircle = circle
				end
			end
			if fill and not fovFill then
				local ok, circle = pcall(Drawing.new, "Circle")
				if ok and circle then
					circle.Thickness = 1
					circle.Filled = true
					circle.NumSides = 64
					circle.Transparency = 0.85
					fovFill = circle
				end
			end

			if fovCircle then
				fovCircle.Visible = true
				fovCircle.Radius = fov
				fovCircle.Color = SettingsManager.get(SettingsKeys.SilentAimFOVColor)
				fovCircle.Position = pos
			end
			if fovFill then
				fovFill.Visible = fill
				if fill then
					fovFill.Radius = fov
					fovFill.Color = SettingsManager.get(SettingsKeys.SilentAimFOVFillColor)
					fovFill.Position = pos
				end
			end
		end,
		startHeartbeat = function(callback)
			if heartbeat then
				heartbeat:Disconnect()
				heartbeat = nil
			end
			heartbeat = RunService.Heartbeat:Connect(callback)
		end,
		stopHeartbeat = function()
			if heartbeat then
				heartbeat:Disconnect()
				heartbeat = nil
			end
		end,
		disable = function()
			if heartbeat then
				heartbeat:Disconnect()
				heartbeat = nil
			end
			target = nil
			if fovCircle then fovCircle.Visible = false end
			if fovFill then fovFill.Visible = false end
		end,
		reset = function()
			if heartbeat then
				heartbeat:Disconnect()
				heartbeat = nil
			end
			target = nil
			removeFOV()
		end,
	}
end)()

local VisualizeInfra = (function()
	local connection = nil

	return {
		ensureConnected = function(onVisualize)
			if connection then return end

			local replicatedStorage = game:GetService("ReplicatedStorage")
			local events2 = replicatedStorage:FindFirstChild("Events2", true)
			local visualize = events2 and events2:FindFirstChild("Visualize", true)
			if visualize then
