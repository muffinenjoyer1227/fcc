local MinecraftiaFont = nil

do
	local function b64decode(s)
		if type(s) ~= "string" or #s < 100 then
			return nil
		end
		s = s:gsub("%s+", "")

		local decoded = nil
		if crypt then
			if crypt.base64 and crypt.base64.decode then
				local ok, r = pcall(crypt.base64.decode, s)
				if ok then decoded = r end
			elseif crypt.base64decode then
				local ok, r = pcall(crypt.base64decode, s)
				if ok then decoded = r end
			end
		end
		if not decoded and base64decode then
			local ok, r = pcall(base64decode, s)
			if ok then decoded = r end
		end
		if not decoded and base64_decode then
			local ok, r = pcall(base64_decode, s)
			if ok then decoded = r end
		end

		if type(decoded) ~= "string" or #decoded < 1000 then
			return nil
		end
		return decoded
	end

	local function loadMinecraftia(b64)
		if not (isfile and writefile and getcustomasset) then
			error("executor missing isfile/writefile/getcustomasset")
		end

		local binary = b64decode(b64)
		if not binary then
			error("base64 decode failed (empty B64 or no crypt.base64.decode)")
		end

		pcall(delfile, "Minecraftia.ttf")
		pcall(delfile, "Minecraftia.font")
		writefile("Minecraftia.ttf", binary)

		local ttfAsset = getcustomasset("Minecraftia.ttf")
		if type(ttfAsset) ~= "string" or ttfAsset == "" then
			error("getcustomasset(Minecraftia.ttf) failed")
		end

		local fontJson = game:GetService("HttpService"):JSONEncode({
			name = "Minecraftia",
			faces = {{
				name = "Normal",
				weight = 400,
				style = "Normal",
				assetId = ttfAsset,
			}},
		})
		writefile("Minecraftia.font", fontJson)

		local fontAsset = getcustomasset("Minecraftia.font")
		if type(fontAsset) ~= "string" or fontAsset == "" then
			error("getcustomasset(Minecraftia.font) failed")
		end

		return Font.new(fontAsset, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end

	local MinecraftiaB64 = ""

	local ok, result = pcall(loadMinecraftia, MinecraftiaB64)
	if ok and result then
		MinecraftiaFont = result
	else
		warn("[fraud.cc] Minecraftia failed:", result)
	end
end

