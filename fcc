local VisibilityCache = (function()
	local cache = {}
	local lastCameraCFrame = nil

	local function invalidateIfCameraMoved(camera)
		local cameraCFrame = camera.CFrame
		if lastCameraCFrame then
			local positionDelta = (cameraCFrame.Position - lastCameraCFrame.Position).Magnitude
			local lookAlignment = cameraCFrame.LookVector:Dot(lastCameraCFrame.LookVector)
			if positionDelta > CONSTANTS.VISIBILITY_CAMERA_MOVE_THRESHOLD
				or lookAlignment < CONSTANTS.VISIBILITY_CAMERA_ROT_THRESHOLD then
				table.clear(cache)
			end
		end
		lastCameraCFrame = cameraCFrame
	end

	return {
		isCharacterVisible = function(character, targetPart, camera)
			invalidateIfCameraMoved(camera)
			local entry = cache[character]
			local now = os.clock()
			if entry and (now - entry.time) < CONSTANTS.VISIBILITY_CACHE_TTL then
				return entry.visible
			end

			local origin = camera.CFrame.Position
			local direction = targetPart.Position - origin

			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local filter = { camera }
			if LocalPlayer.Character then
				table.insert(filter, LocalPlayer.Character)
			end
			table.insert(filter, character)
			params.FilterDescendantsInstances = filter

			local result = workspace:Raycast(origin, direction, params)
			local visible = result == nil

			cache[character] = { visible = visible, time = now }
			return visible
		end,
		clearForCharacter = function(character)
			if character then
				cache[character] = nil
			end
		end,
		clearAll = function()
			table.clear(cache)
			lastCameraCFrame = nil
		end,
	}
end)()

