-- rows
local function createPlayerRow(player)
	if not listScroll or player == LocalPlayer then
		return nil
	end

	local sc = getScheme()
	local display = player.DisplayName ~= player.Name
		and (player.DisplayName .. "  @" .. player.Name)
		or player.Name

	local row = Instance.new("TextButton")
	row.Name = player.Name
	row.Size = UDim2.new(1, -4, 0, 24)
	row.BackgroundColor3 = sc.Row
	row.BorderSizePixel = 1
	row.BorderColor3 = Color3.fromRGB(25, 25, 25)
	row.Text = ""
	row.AutoButtonColor = false
	row.ZIndex = 11
	row.Parent = listScroll

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, -10, 1, 0)
	nameLabel.Position = UDim2.new(0, 6, 0, 0)
	nameLabel.Font = Enum.Font.Code
	nameLabel.TextSize = 13
	nameLabel.TextColor3 = getStatusColor(getPlayerStatus(player))
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Text = display
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.ZIndex = 12
	nameLabel.Parent = row

	row.MouseEnter:Connect(function()
		if selectedPlayer ~= player then
			row.BackgroundColor3 = sc.RowHover
		end
	end)
	row.MouseLeave:Connect(function()
		if selectedPlayer ~= player then
			row.BackgroundColor3 = sc.Row
		end
	end)
	row.MouseButton1Click:Connect(function()
		if selectedPlayer and playerRows[selectedPlayer] then
			playerRows[selectedPlayer].BackgroundColor3 = sc.Row
		end
		selectedPlayer = player
		row.BackgroundColor3 = sc.RowSelect
		updateSelectedUI()
	end)

	return row
end

local function addPlayer(player)
	if player == LocalPlayer then return end
	if not listScroll then
		warn("[fraud.cc] listScroll is nil")
		return
	end
	if playerRows[player] then return end
	playerRows[player] = createPlayerRow(player)
end

local function removePlayer(player)
	if playerRows[player] then
		pcall(function() playerRows[player]:Destroy() end)
		playerRows[player] = nil
	end
	if selectedPlayer == player then
		selectedPlayer = nil
		updateSelectedUI()
	end
	TargetListManager.removePlayer(player)
end

removePlayerChecksUI = removePlayer

if listScroll then
	for _, player in ipairs(Players:GetPlayers()) do
		addPlayer(player)
	end
else
	warn("[fraud.cc] listScroll is nil")
end

table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))

