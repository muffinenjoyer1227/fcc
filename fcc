local PlayersBox = Tabs.Checks:AddLeftGroupbox("Players")

PlayersBox:AddInput("ChecksPlayerSearch", {
	Default = "",
	Numeric = false,
	Finished = false,
	Text = "Search",
	Placeholder = "Name or username...",
	Callback = function(value)
		checksSearchText = string.lower(tostring(value or ""))
		for player, row in pairs(playerRows) do
			if row and row.Parent then
				local name = string.lower(player.Name or "")
				local display = string.lower(player.DisplayName or "")
				row.Visible = checksSearchText == ""
					or string.find(name, checksSearchText, 1, true)
					or string.find(display, checksSearchText, 1, true)
			end
		end
	end,
})

