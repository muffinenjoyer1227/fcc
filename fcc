local TPWalkOwner = (function()
	local conn = nil

	local function setEnabled(on)
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if not on then
			return
		end
		conn = RunService.RenderStepped:Connect(function(dt)
			if unloaded then return end
			if not SettingsManager.get(SettingsKeys.TPWalkEnabled) then return end

			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then return end

			local moveDir = hum.MoveDirection
			if moveDir.Magnitude > 0 then
				local speed = SettingsManager.get(SettingsKeys.TPWalkSpeed) or 16
				hrp.CFrame = hrp.CFrame + moveDir.Unit * speed * dt
			end
		end)
	end

	if SettingsManager.get(SettingsKeys.TPWalkEnabled) then
		setEnabled(true)
	end

	trackSettingsListener(SettingsManager.onChanged(function(key, value)
		if key == SettingsKeys.TPWalkEnabled then
			setEnabled(value == true)
		end
	end))

	return {
		setEnabled = setEnabled,
		reset = function()
			setEnabled(false)
		end,
	}
end)()

local WorldOwner = (function()
	local Lighting = game:GetService("Lighting")
	local RunService = game:GetService("RunService")

	local Orig = {}
	local Conns = {}
	local bloomObj = nil
	local skyObj = nil
	local savedFov = nil
	local timeConn = nil
	local fovConn = nil

	local SkyBoxes = {
		["Default"] = {
			SkyboxLf = "rbxassetid://148943339",
			SkyboxBk = "rbxassetid://148943390",
			SkyboxDn = "rbxassetid://148943362",
			SkyboxFt = "rbxassetid://148943404",
			SkyboxRt = "rbxassetid://148943379",
			SkyboxUp = "rbxassetid://148943410",
		},
		["Sunset"] = {
			SkyboxLf = "rbxassetid://15502522129",
			SkyboxBk = "rbxassetid://15502525195",
			SkyboxDn = "rbxassetid://15502522797",
			SkyboxFt = "rbxassetid://15502524520",
			SkyboxRt = "rbxassetid://15502523711",
			SkyboxUp = "rbxassetid://15502526102",
		},
		["Peaceful"] = {
			SkyboxBk = "rbxassetid://73252679982122",
			SkyboxDn = "rbxassetid://101074061181553",
			SkyboxFt = "rbxassetid://112572775732134",
			SkyboxLf = "rbxassetid://126931573973019",
			SkyboxRt = "rbxassetid://135908172504233",
			SkyboxUp = "rbxassetid://124514468649717",
		},
		["Space"] = {
			SkyboxBk = "rbxassetid://16876760844",
			SkyboxDn = "rbxassetid://16876762818",
			SkyboxFt = "rbxassetid://16876765234",
			SkyboxLf = "rbxassetid://16876767659",
			SkyboxRt = "rbxassetid://16876769447",
			SkyboxUp = "rbxassetid://16876771721",
		},
	}

	local function saveOrig()
		if Orig.saved then
			return
		end
		Orig.saved = true
		Orig.ClockTime = Lighting.ClockTime
		Orig.Brightness = Lighting.Brightness
		Orig.GlobalShadows = Lighting.GlobalShadows
		Orig.Ambient = Lighting.Ambient
		Orig.OutdoorAmbient = Lighting.OutdoorAmbient
		Orig.ColorShift_Top = Lighting.ColorShift_Top
		Orig.ColorShift_Bottom = Lighting.ColorShift_Bottom
		Orig.ExposureCompensation = Lighting.ExposureCompensation
		pcall(function()
			Orig.Technology = Lighting.Technology
		end)
	end

	local function conn(key, prop, fn)
		if Conns[key] then
			Conns[key]:Disconnect()
			Conns[key] = nil
		end
		local ok, sig = pcall(function()
			return Lighting:GetPropertyChangedSignal(prop)
		end)
		if ok and sig then
			Conns[key] = sig:Connect(fn)
		end
	end

	local function disconn(key)
		if Conns[key] then
			Conns[key]:Disconnect()
			Conns[key] = nil
		end
	end

	local function getBloom()
		if bloomObj and bloomObj.Parent then
			return bloomObj
		end
		bloomObj = Lighting:FindFirstChild("FraudBloom")
		if not bloomObj then
			bloomObj = Instance.new("BloomEffect")
			bloomObj.Name = "FraudBloom"
			bloomObj.Enabled = false
			bloomObj.Parent = Lighting
		end
		return bloomObj
	end

	local function applyFullbright(on)
		saveOrig()
		if on then
			Lighting.ClockTime = 14
			Lighting.Brightness = 5
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.fromRGB(178, 178, 178)
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("PostEffect") and e.Name ~= "FraudBloom" then
					pcall(function()
						e.Enabled = false
					end)
				end
			end
			conn("ClockTime_fb", "ClockTime", function()
				if SettingsManager.get(SettingsKeys.WorldFullbright) then
					Lighting.ClockTime = 14
				end
			end)
			conn("Brightness_fb", "Brightness", function()
				if SettingsManager.get(SettingsKeys.WorldFullbright) then
					Lighting.Brightness = 5
				end
			end)
			conn("GlobalShadows_fb", "GlobalShadows", function()
				if SettingsManager.get(SettingsKeys.WorldFullbright) then
					Lighting.GlobalShadows = false
				end
			end)
			conn("Ambient_fb", "Ambient", function()
				if SettingsManager.get(SettingsKeys.WorldFullbright) then
					Lighting.Ambient = Color3.fromRGB(178, 178, 178)
				end
			end)
		else
			disconn("ClockTime_fb")
			disconn("Brightness_fb")
			disconn("GlobalShadows_fb")
			disconn("Ambient_fb")
			if Orig.ClockTime ~= nil then
				Lighting.ClockTime = Orig.ClockTime
			end
			if Orig.Brightness ~= nil then
				Lighting.Brightness = Orig.Brightness
			end
			if Orig.GlobalShadows ~= nil then
				Lighting.GlobalShadows = Orig.GlobalShadows
			end
			if Orig.Ambient ~= nil then
				Lighting.Ambient = Orig.Ambient
			end
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("PostEffect") and e.Name ~= "FraudBloom" then
					pcall(function()
						e.Enabled = true
					end)
				end
			end
			if SettingsManager.get(SettingsKeys.WorldNoShadows) then
				Lighting.GlobalShadows = false
			end
			if SettingsManager.get(SettingsKeys.WorldCustomTime) then
				Lighting.ClockTime = SettingsManager.get(SettingsKeys.WorldTime) or 13
			end
			if SettingsManager.get(SettingsKeys.WorldCustomAmbience) then
				Lighting.Ambient = SettingsManager.get(SettingsKeys.WorldAmbienceTop)
				Lighting.OutdoorAmbient = SettingsManager.get(SettingsKeys.WorldAmbienceBot)
			end
		end
	end

	local function applyAmbience(on)
		saveOrig()
		if on then
			Lighting.Ambient = SettingsManager.get(SettingsKeys.WorldAmbienceTop)
			Lighting.OutdoorAmbient = SettingsManager.get(SettingsKeys.WorldAmbienceBot)
			conn("Ambient_ca", "Ambient", function()
				if SettingsManager.get(SettingsKeys.WorldCustomAmbience) then
					Lighting.Ambient = SettingsManager.get(SettingsKeys.WorldAmbienceTop)
				end
			end)
			conn("OutdoorAmbient_ca", "OutdoorAmbient", function()
				if SettingsManager.get(SettingsKeys.WorldCustomAmbience) then
					Lighting.OutdoorAmbient = SettingsManager.get(SettingsKeys.WorldAmbienceBot)
				end
			end)
		else
			disconn("Ambient_ca")
			disconn("OutdoorAmbient_ca")
			if Orig.Ambient then
				Lighting.Ambient = Orig.Ambient
			end
			if Orig.OutdoorAmbient then
				Lighting.OutdoorAmbient = Orig.OutdoorAmbient
			end
		end
	end

	local function applyColorshift(on)
		saveOrig()
		if on then
			Lighting.ColorShift_Top = SettingsManager.get(SettingsKeys.WorldShiftTop)
			Lighting.ColorShift_Bottom = SettingsManager.get(SettingsKeys.WorldShiftBot)
		else
			if Orig.ColorShift_Top then
				Lighting.ColorShift_Top = Orig.ColorShift_Top
			end
			if Orig.ColorShift_Bottom then
				Lighting.ColorShift_Bottom = Orig.ColorShift_Bottom
			end
		end
	end

	local function applyExposure(on)
		saveOrig()
		if on then
			Lighting.ExposureCompensation = SettingsManager.get(SettingsKeys.WorldExposureAmt) or -0.08
		else
			if Orig.ExposureCompensation ~= nil then
				Lighting.ExposureCompensation = Orig.ExposureCompensation
			end
		end
	end

	local function applyCustomTime(on)
		saveOrig()
		if timeConn then
			timeConn:Disconnect()
			timeConn = nil
		end
		if on then
			Lighting.ClockTime = SettingsManager.get(SettingsKeys.WorldTime) or 13
			timeConn = RunService.RenderStepped:Connect(function()
				if SettingsManager.get(SettingsKeys.WorldCustomTime) then
					Lighting.ClockTime = SettingsManager.get(SettingsKeys.WorldTime) or 13
				end
			end)
		else
			if Orig.ClockTime ~= nil and not SettingsManager.get(SettingsKeys.WorldFullbright) then
				Lighting.ClockTime = Orig.ClockTime
			end
		end
	end

	local function applyNoShadows(on)
		saveOrig()
		Lighting.GlobalShadows = not on
	end

	local function applyBloom(on)
		local b = getBloom()
		b.Enabled = on
		if on then
			b.Intensity = SettingsManager.get(SettingsKeys.WorldBloomIntensity) or 56
			b.Size = SettingsManager.get(SettingsKeys.WorldBloomSize) or 4.1
			b.Threshold = SettingsManager.get(SettingsKeys.WorldBloomThreshold) or 90.2
		end
	end

	local function applyLightTech(on)
		saveOrig()
		if on then
			local name = SettingsManager.get(SettingsKeys.WorldLightTech) or "Future"
			pcall(function()
				Lighting.Technology = Enum.Technology[name]
			end)
		else
			if Orig.Technology ~= nil then
				pcall(function()
					Lighting.Technology = Orig.Technology
				end)
			end
		end
	end

	local function applySkybox(on)
		if not on then
			if skyObj then
				pcall(function()
					skyObj:Destroy()
				end)
				skyObj = nil
			end
			return
		end
		local name = SettingsManager.get(SettingsKeys.WorldSkybox) or "Peaceful"
		local data = SkyBoxes[name]
		if not data then
			return
		end
		if not skyObj or not skyObj.Parent then
			skyObj = Instance.new("Sky")
			skyObj.Name = "FraudSky"
			skyObj.Parent = Lighting
		end
		for k, v in pairs(data) do
			pcall(function()
				skyObj[k] = v
			end)
		end
	end

	local function applyCameraFOV(on)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		if fovConn then
			fovConn:Disconnect()
			fovConn = nil
		end
		if on then
			if savedFov == nil then
				savedFov = cam.FieldOfView
			end
			cam.FieldOfView = SettingsManager.get(SettingsKeys.WorldCameraFOV) or 70
			fovConn = RunService.RenderStepped:Connect(function()
				if SettingsManager.get(SettingsKeys.WorldCustomCameraFOV) and workspace.CurrentCamera then
					workspace.CurrentCamera.FieldOfView = SettingsManager.get(SettingsKeys.WorldCameraFOV) or 70
				end
			end)
		else
			if savedFov ~= nil and workspace.CurrentCamera then
				workspace.CurrentCamera.FieldOfView = savedFov
			end
			savedFov = nil
		end
	end

	local function refreshAll()
		applyFullbright(SettingsManager.get(SettingsKeys.WorldFullbright) == true)
		applyAmbience(SettingsManager.get(SettingsKeys.WorldCustomAmbience) == true)
		applyColorshift(SettingsManager.get(SettingsKeys.WorldColorshift) == true)
		applyExposure(SettingsManager.get(SettingsKeys.WorldExposure) == true)
		applyCustomTime(SettingsManager.get(SettingsKeys.WorldCustomTime) == true)
		applyNoShadows(SettingsManager.get(SettingsKeys.WorldNoShadows) == true)
		applyBloom(SettingsManager.get(SettingsKeys.WorldBloom) == true)
		applyLightTech(SettingsManager.get(SettingsKeys.WorldLightTechEnabled) == true)
		applySkybox(SettingsManager.get(SettingsKeys.WorldCustomSkybox) == true)
		applyCameraFOV(SettingsManager.get(SettingsKeys.WorldCustomCameraFOV) == true)
	end

	local function reset()
		for k in pairs(Conns) do
			disconn(k)
		end
		if timeConn then
			timeConn:Disconnect()
			timeConn = nil
		end
		if fovConn then
			fovConn:Disconnect()
			fovConn = nil
		end
		if bloomObj then
			pcall(function()
				bloomObj:Destroy()
			end)
			bloomObj = nil
		end
		if skyObj then
			pcall(function()
				skyObj:Destroy()
			end)
			skyObj = nil
		end
		if Orig.saved then
			if Orig.ClockTime ~= nil then
				Lighting.ClockTime = Orig.ClockTime
			end
			if Orig.Brightness ~= nil then
				Lighting.Brightness = Orig.Brightness
			end
			if Orig.GlobalShadows ~= nil then
				Lighting.GlobalShadows = Orig.GlobalShadows
			end
			if Orig.Ambient ~= nil then
				Lighting.Ambient = Orig.Ambient
			end
			if Orig.OutdoorAmbient ~= nil then
				Lighting.OutdoorAmbient = Orig.OutdoorAmbient
			end
			if Orig.ColorShift_Top ~= nil then
				Lighting.ColorShift_Top = Orig.ColorShift_Top
			end
			if Orig.ColorShift_Bottom ~= nil then
				Lighting.ColorShift_Bottom = Orig.ColorShift_Bottom
			end
			if Orig.ExposureCompensation ~= nil then
				Lighting.ExposureCompensation = Orig.ExposureCompensation
			end
			if Orig.Technology ~= nil then
				pcall(function()
					Lighting.Technology = Orig.Technology
				end)
			end
		end
		if savedFov ~= nil and workspace.CurrentCamera then
			workspace.CurrentCamera.FieldOfView = savedFov
		end
		savedFov = nil
		Orig = {}
	end

	return {
		applyFullbright = applyFullbright,
		applyAmbience = applyAmbience,
		applyColorshift = applyColorshift,
		applyExposure = applyExposure,
		applyCustomTime = applyCustomTime,
		applyNoShadows = applyNoShadows,
		applyBloom = applyBloom,
		applyLightTech = applyLightTech,
		applySkybox = applySkybox,
		applyCameraFOV = applyCameraFOV,
		refreshAll = refreshAll,
		reset = reset,
		SkyBoxes = SkyBoxes,
	}
end)()


local function bindToggle(box, flag, text, key)
	box:AddToggle(flag, { Text = text, Default = SettingsManager.get(key) == true, Callback = function(Value) SettingsManager.set(key, Value) end })
end

